# =====================================================================
# FITLY backend — cấu hình PRODUCTION. Copy thành `.env.production` (cùng thư mục) rồi điền. KHÔNG commit file thật.
# Sinh chuỗi ngẫu nhiên:  openssl rand -hex 32
# =====================================================================

# --- Bắt buộc ---------------------------------------------------------
# Tên miền của API (Caddy tự cấp HTTPS). Cần A record trỏ về IP máy chủ. Chưa có tên miền: api.<IP-bằng-dấu-chấm>.sslip.io (vd api.160.191.242.112.sslip.io)
SITE_ADDRESS=api.example.com
EF_API_PUBLIC_URL=https://api.example.com
EF_PUBLIC_URL=https://api.example.com

# Image backend đang chạy. CD (docs/09_CD.md) tự ghi dòng này mỗi lần deploy (ghcr.io/<owner>/<repo>:sha-xxxx). Để trống / không có dòng này
# = dùng image tự build tại máy chủ bằng ./deploy.sh (`fitly-backend:prod`).
# FITLY_IMAGE=

# Mật khẩu Postgres + Redis (nội bộ Docker, không mở ra ngoài)
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Khoá ký JWT — >= 32 ký tự, KHÔNG dùng giá trị mẫu (đổi là mọi người bị đăng xuất)
EF_JWT_SECRET=

# Tài khoản admin: tạo lần đầu bằng 2 biến này. Mật khẩu >= 12 ký tự, không phải mật khẩu mẫu.
EF_ADMIN_EMAIL=admin@example.com
EF_ADMIN_PASSWORD=
# Chỉ dùng khi nạp dữ liệu mẫu (profile demo-data): mật khẩu mới cho nhân viên sàn mẫu (manager/sales/…); để trống = KHOÁ các tài khoản đó.
EF_STAFF_PASSWORD=

# --- Địa chỉ web (CORS, link trong email, PayOS redirect) -----------------------
# Tên miền Vercel của web bán hàng + web quản trị — ĐÚNG origin (https, không dấu / cuối), cách nhau bằng dấu phẩy.
EF_CORS_ORIGINS=https://fitly-shop.vercel.app,https://fitly-admin.vercel.app
EF_STOREFRONT_URL=https://fitly-shop.vercel.app
EF_WEB_URL=https://fitly-shop.vercel.app
# URL web quản trị — PayOS redirect chủ shop về sau khi nạp cọc (PLAN-0041); production BẮT BUỘC https
EF_ADMIN_URL=https://fitly-admin.vercel.app

# --- Mặc định hợp lý cho production ------------------------------------------
EF_APP_NAME=FITLY
EF_SWAGGER_ENABLED=false
EF_LOG_LEVEL=info
# 1 lớp proxy (Caddy) đứng trước API → lấy đúng IP khách cho rate-limit/audit
EF_TRUSTED_PROXY_COUNT=1

# --- Đăng nhập Google (xem docs/08_DEPLOY.md mục Google) -----------------------
# Trùng NEXT_PUBLIC_GOOGLE_CLIENT_ID của web bán hàng. Trống = tắt đăng nhập Google.
EF_GOOGLE_CLIENT_ID=

# --- Email (OTP đăng ký, quên mật khẩu, đơn hàng) — bắt buộc nếu cho khách đăng ký bằng email -----
EF_MAIL_HOST=smtp.gmail.com
EF_MAIL_PORT=465
EF_MAIL_SECURE=true
EF_MAIL_USER=
EF_MAIL_PASSWORD=
EF_MAIL_FROM=FITLY <no-reply@example.com>

# --- Cloudinary (ảnh người dùng upload: avatar, ảnh đánh giá, ảnh sản phẩm của shop). Ảnh dữ liệu mẫu đã có link sẵn -----
EF_CLOUDINARY_CLOUD_NAME=
EF_CLOUDINARY_API_KEY=
EF_CLOUDINARY_API_SECRET=

# --- Tuỳ chọn: AI, thanh toán (để trống = tính năng tự tắt/lùi về chế độ không khoá) -----
EF_OPENAI_API_KEY=
EF_REPLICATE_API_TOKEN=
EF_AI_DAILY_TOKEN_BUDGET=0
EF_PAYOS_CLIENT_ID=
EF_PAYOS_API_KEY=
EF_PAYOS_CHECKSUM_KEY=
# Kênh CHI (lệnh chi trả shop + hoàn tiền): khoá riêng của kênh chi trên my.payos.vn. Để TRỐNG = không chi tự động (kỳ chi ở trạng thái pending cho kế toán chuyển tay).
# Sao chép khoá vào máy chủ — KHÔNG commit. Cron chi trả mặc định TẮT (payout.auto_enabled=false) cho tới khi chi tay 2 kỳ khớp (PLAN-0026).
EF_PAYOS_PAYOUT_CLIENT_ID=
EF_PAYOS_PAYOUT_API_KEY=
EF_PAYOS_PAYOUT_CHECKSUM_KEY=

# PLAN-0044: bật profile visual-search và encoder nội bộ để tìm trực tiếp theo ảnh.
# Production: COMPOSE_PROFILES=visual-search; URL http://visual-encoder:8080.
# Dev chạy Nest ngoài Docker: publish encoder chỉ lên127.0.0.1 trước khi dùng localhost URL.
EF_VISUAL_ENCODER_URL=
EF_VISUAL_ENCODER_TOKEN=
EF_VISUAL_MODEL_VERSION=google/siglip2-base-patch16-224@75de2d55ec2d0b4efc50b3e9ad70dba96a7b2fa2
EF_VISUAL_IMAGE_ORIGINS=https://res.cloudinary.com
# Ngưỡng thử nghiệm, cần hiệu chỉnh bằng benchmark; KHÔNG là phần trăm chính xác.
EF_VISUAL_MIN_SIMILARITY=0.65
EF_VISUAL_RERANK=true
# Optional: worker Docker tải ảnh /static qua mạng nội bộ, VD http://api:4000
EF_VISUAL_CATALOG_BASE_URL=

# PLAN-0045 Live: trống = phát video trả503; các chức năng khác vẫn hoạt động.
# Dùng LiveKit Cloud hoặc self-host theo deploy/livekit.example.yaml (room.auto_create:false bắt buộc).
EF_LIVEKIT_URL=
EF_LIVEKIT_API_KEY=
EF_LIVEKIT_API_SECRET=
EF_LIVE_MAX_VIEWERS=10
EF_LIVE_DURATION_MINUTES=60
