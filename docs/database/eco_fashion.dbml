// EcoFashion — sơ đồ DB (dán vào https://dbdiagram.io). Cập nhật sau mỗi plan có migration.
// Phản ánh trạng thái tới migration 20261013090000_drop_shop_invitations (12 schema: thêm `shop` — sàn đa gian hàng, PLAN-0014/0016/0017).
// Quy ước: schema = module; không FK xuyên schema (tham chiếu chéo bằng id + code + snapshot).
// Cột chuẩn (+base): created_at, created_by, updated_at, updated_by, version, is_deleted.
// Mỗi bảng viết nhiều dòng (DBML không cho nhiều cột trên một dòng). CHECK / partial unique index / trigger mà Prisma không
// biểu diễn được ghi trong `note` của cột hoặc `Note` của bảng — chi tiết SQL ở prisma/migrations/*/migration.sql.

Project eco_fashion {
  database_type: 'PostgreSQL'
  Note: 'Nguồn sự thật là prisma/schema/*.prisma + prisma/migrations. File này chỉ để nhìn tổng thể.'
}

// ===================================================== identity (PLAN-0002, PLAN-0014 bước 2)

Table identity.roles {
  id uuid [pk]
  code varchar(40) [unique, note: 'platform: admin · manager · sales · warehouse · accountant · marketing · customer | shop: shop_owner · shop_staff']
  name varchar(100)
  description varchar(255)
  is_system boolean [default: true]
  scope varchar(20) [not null, default: 'platform', note: 'platform | shop — CHECK ck_roles_scope. Vai scope=shop KHÔNG BAO GIỜ gán vào users.role_id, chỉ dùng qua shop.shop_members.role_id (migration 20260928014603)']
  created_at timestamptz
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  version int
  is_deleted boolean
}

Table identity.permissions {
  id uuid [pk]
  code varchar(100) [unique, note: 'module.resource.action — từ permission/catalog.ts qua perms:sync']
  module_code varchar(40)
  description varchar(255)
  is_active boolean [default: true]
  created_at timestamptz
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  version int
  is_deleted boolean
}

Table identity.role_permissions {
  role_id uuid [pk]
  permission_id uuid [pk]
  created_at timestamptz
  created_by uuid
}

Table identity.users {
  id uuid [pk]
  email varchar(255) [note: 'UQ partial lower(email) WHERE is_deleted=false']
  phone varchar(20) [note: 'UQ partial WHERE is_deleted=false']
  password_hash varchar(255) [note: 'argon2id']
  full_name varchar(120)
  avatar_url varchar(500)
  role_id uuid [note: 'chỉ vai scope=platform (nhân viên sàn / customer)']
  status varchar(30) [note: 'active · locked · inactive']
  permission_version int [default: 1, note: 'bump khi đổi vai/quyền/mật khẩu/khoá → token cũ mất hiệu lực']
  email_verified_at timestamptz
  last_login_at timestamptz
  locked_reason varchar(255)
  google_sub varchar(64) [null, unique, note: 'đăng nhập Google: sub của id_token (migration 20260915070000)']
  created_at timestamptz
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  version int
  is_deleted boolean
}

Table identity.user_permissions {
  user_id uuid [pk]
  permission_id uuid [pk]
  allowed boolean [note: 'true = cấp thêm, false = chặn (deny thắng vai)']
  reason varchar(255)
  created_at timestamptz
  created_by uuid
  updated_at timestamptz
  updated_by uuid
}

Table identity.refresh_tokens {
  id uuid [pk]
  user_id uuid
  token_hash varchar(64) [unique, note: 'SHA-256 của token thô — DB không giữ token']
  family_id uuid [note: 'một chuỗi rotation; dùng lại token đã rotate → thu hồi cả họ']
  device_name varchar(120)
  ip_address varchar(45)
  user_agent varchar(255)
  expires_at timestamptz
  revoked_at timestamptz
  revoked_reason varchar(40)
  replaced_by_id uuid
  last_used_at timestamptz
  created_at timestamptz
}

Table identity.login_histories {
  id uuid [pk]
  user_id uuid [null]
  email varchar(255)
  success boolean
  reason varchar(40) [note: 'REGISTER · INVALID_CREDENTIALS · THROTTLED · USER_LOCKED · tên thiết bị']
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz [note: 'dọn sau EF_LOGIN_HISTORY_RETENTION_DAYS']
}

Table identity.addresses {
  id uuid [pk]
  user_id uuid
  recipient_name varchar(120)
  phone varchar(20)
  province_code varchar(10) [null, note: 'mã tỉnh (system.provinces) — chụp lại tên để địa chỉ cũ không đổi']
  province_name varchar(100)
  district_name varchar(100)
  ward_name varchar(100)
  street varchar(255)
  is_default boolean [note: 'UQ partial (user_id) WHERE is_default AND NOT is_deleted']
  note varchar(255)
  created_at timestamptz
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  version int
  is_deleted boolean
}

Table identity.audit_logs {
  id uuid [pk]
  actor_user_id uuid
  actor_email varchar(255)
  action varchar(80)
  module_code varchar(40)
  entity_type varchar(80)
  entity_id varchar(64)
  entity_code varchar(100)
  request_id varchar(64)
  idempotency_key varchar(128)
  before_summary jsonb
  after_summary jsonb
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz
}

Table identity.outbox_events {
  id uuid [pk]
  event_type varchar(80)
  event_version varchar(10)
  aggregate_type varchar(80)
  aggregate_id varchar(64)
  payload jsonb
  status varchar(20) [note: 'PENDING · PROCESSING · DONE · FAILED']
  retry_count int
  next_attempt_at timestamptz
  error_message text
  request_id varchar(64)
  processed_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}

Table identity.processed_events {
  id uuid [pk]
  event_id uuid
  event_type varchar(80)
  handler varchar(120)
  processed_at timestamptz
  Note: 'UQ (event_id, handler) — listener idempotent'
}

Ref: identity.role_permissions.role_id > identity.roles.id
Ref: identity.role_permissions.permission_id > identity.permissions.id
Ref: identity.users.role_id > identity.roles.id
Ref: identity.user_permissions.user_id > identity.users.id
Ref: identity.user_permissions.permission_id > identity.permissions.id
Ref: identity.refresh_tokens.user_id > identity.users.id
Ref: identity.addresses.user_id > identity.users.id



// ===================================================== shop (PLAN-0014 bước 1, PLAN-0017) — migration 20260928014536_shop_init

// Gian hàng của sàn đa gian hàng. owner_user_id / user_id / role_id là id TRẦN trỏ sang schema identity — không FK xuyên schema.
// Gian hàng chính chủ "FITLY Official" (id 00000000-0000-0000-0000-000000000001, code SHOP-000001, hoa hồng 0, status approved)
// được migration 20260929084707 tạo sẵn để backfill dữ liệu cũ; owner_user_id của nó là UUID giữ chỗ cùng giá trị, không phải user thật.

Table shop.shops {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(20) [unique, not null]
  slug varchar(160) [unique, not null]
  name varchar(200) [not null]
  logo_url varchar(500) [null]
  banner_url varchar(500) [null]
  description varchar(2000) [null]
  status varchar(20) [not null, default: 'pending', note: 'pending | approved | suspended | rejected — CHECK ck_shops_status; lưới chuyển ở SHOP_TRANSITIONS (foundation/shop.constants.ts). Sàn quản status/commission_rate/cod_enabled, vendor tự sửa hồ sơ']
  commission_rate numeric(5,2) [not null, default: 10.00, note: '% hoa hồng sàn thu — CHECK ck_shops_commission_rate 0..100; đóng băng vào order.orders.commission_rate_snapshot lúc đặt hàng']
  cod_enabled boolean [not null, default: true, note: 'tự tắt khi ví COD (payment.shop_wallets) về <= 0']
  bank_code varchar(20) [null, note: 'PLAN-0017 (migration 20261003100000): BIN ngân hàng Napas/PayOS (6 số) — toBin khi chi tiền đối soát']
  bank_account_number varchar(30) [null]
  bank_account_name varchar(120) [null]
  rating_avg numeric(3,2) [null]
  total_products int [not null, default: 0, note: 'denormalized; CHECK ck_shops_total_products >= 0']
  owner_user_id uuid [not null, note: 'identity.users.id đứng tên đăng ký — không FK xuyên schema']
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid [null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by uuid [null]
  is_deleted boolean [not null, default: false]
  Note: 'UQ code, UQ slug (unique thường, không partial). Index status, owner_user_id'
}

Table shop.shop_members {
  id uuid [pk, default: `gen_random_uuid()`]
  shop_id uuid [not null]
  user_id uuid [not null, note: 'identity.users.id — không FK xuyên schema']
  role_id uuid [not null, note: 'identity.roles.id của vai scope=shop (shop_owner | shop_staff) — không FK xuyên schema']
  status varchar(20) [not null, default: 'active', note: 'active | removed — CHECK ck_shop_members_status; gỡ nhân viên = status removed (giữ lịch sử, không xoá cứng)']
  created_at timestamptz [not null, default: `now()`]
  created_by uuid [null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by uuid [null]
  Note: 'Bảng n-n Shop-User. UQ (shop_id, user_id). Index (user_id, status). UQ MỘT PHẦN uq_shop_members_one_active_per_user (user_id) WHERE status = ''active'' — mỗi người chỉ thuộc MỘT gian hàng active (migration 20261004090000, viết tay vì Prisma không biểu diễn; GIỮ nguyên khi bảng lời mời bị bỏ ở 20261013090000). Dòng thành viên do chủ shop THÊM TRỰC TIẾP (POST /shop/members: tạo tài khoản khách + dòng này trong một transaction; nhân viên cũ bị gỡ được thêm lại = kích hoạt lại chính dòng này). Miễn cột version / is_deleted'
}

Table shop.audit_logs {
  id uuid [pk]
  actor_user_id uuid
  actor_email varchar(255)
  action varchar(80)
  module_code varchar(40)
  entity_type varchar(80)
  entity_id varchar(64)
  entity_code varchar(100)
  request_id varchar(64)
  idempotency_key varchar(128)
  before_summary jsonb
  after_summary jsonb
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz
}
Table shop.outbox_events {
  id uuid [pk]
  event_type varchar(80)
  event_version varchar(10)
  aggregate_type varchar(80)
  aggregate_id varchar(64)
  payload jsonb
  status varchar(20)
  retry_count int
  next_attempt_at timestamptz
  error_message text
  request_id varchar(64)
  processed_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}
Table shop.processed_events {
  id uuid [pk]
  event_id uuid
  event_type varchar(80)
  handler varchar(120)
  processed_at timestamptz
  Note: 'UQ (event_id, handler)'
}

Ref: shop.shop_members.shop_id > shop.shops.id

// ===================================================== catalog (PLAN-0003, PLAN-0016)

Table catalog.categories {
  id uuid [pk]
  slug varchar(120) [note: 'UQ partial WHERE is_deleted=false']
  name varchar(120)
  description varchar(500)
  image_url varchar(500)
  image_public_id varchar(255)
  parent_id uuid [null]
  sort_order int
  is_active boolean
  attribute_mode varchar(20) [not null, default: 'dynamic', note: 'PLAN-0016: legacy_fashion = ngành thời trang cũ (sản phẩm dùng gender/material/care + color_code/size_code) | dynamic = ngành mới (dùng dynamic_attributes + category_attributes). Migration 20260929120000 backfill toàn bộ category cũ = legacy_fashion. Chỉ category LÁ được gán sản phẩm, mode đọc từ chính category lá (không kế thừa). Không có CHECK ở DB, service kiểm']
  product_count int [note: 'đếm sẵn — product cập nhật qua CategoryStatsGateway']
  created_at timestamptz
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  version int
  is_deleted boolean
}

Table catalog.collections {
  id uuid [pk]
  slug varchar(120) [note: 'UQ partial sống']
  name varchar(120)
  tagline varchar(200)
  image_url varchar(500)
  image_public_id varchar(255)
  query_category_slug varchar(120) [note: 'bộ sưu tập = bộ lọc có sẵn']
  query_gender varchar(10)
  query_tag varchar(40)
  sort_order int
  is_active boolean
  created_at timestamptz
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  version int
  is_deleted boolean
}

Table catalog.attributes {
  id uuid [pk]
  code varchar(40) [unique, note: 'color · size · material — thuộc tính CỐ ĐỊNH của thời trang (legacy_fashion), giữ nguyên; ngành khác dùng dynamic_attributes']
  name varchar(120)
  kind varchar(20)
  is_filterable boolean
  sort_order int
  created_at timestamptz
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  version int
  is_deleted boolean
}

Table catalog.attribute_values {
  id uuid [pk]
  attribute_id uuid
  code varchar(40) [note: 'UQ (attribute_id, code)']
  name varchar(120)
  hex varchar(9) [note: 'màu']
  group_code varchar(20) [note: 'size: ao | quan']
  sort_order int
  is_active boolean
  created_at timestamptz
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  version int
  is_deleted boolean
}

// PLAN-0016 (migration 20260929120000) — thuộc tính động cho ngành hàng NGOÀI thời trang (điện tử, gia dụng, mỹ phẩm…).
// KHÁC attributes/attribute_values ở trên (khoá cứng 3 mã color/size/material). Không cột chuẩn base (không version/is_deleted).

Table catalog.dynamic_attributes {
  id uuid [pk]
  code varchar(60) [unique, note: 'không giới hạn mã, tạo mới qua API']
  name varchar(100)
  input_type varchar(20) [not null, default: 'select', note: 'select = chọn từ dynamic_attribute_values | text / number = nhập tay (product.product_attribute_values.custom_value)']
  created_at timestamptz
  updated_at timestamptz
}

Table catalog.dynamic_attribute_values {
  id uuid [pk]
  attribute_id uuid
  value varchar(100)
  extra jsonb [null, note: 'vd {"hex":"#ff0000"} khi thuộc tính là màu — tự do theo input_type']
  sort_order int [default: 0]
  Note: 'UQ (attribute_id, value)'
}

Table catalog.category_attributes {
  id uuid [pk]
  category_id uuid [note: 'category LÁ']
  attribute_id uuid
  required boolean [default: false]
  is_variant_axis boolean [default: false, note: 'dùng làm trục biến thể; TỐI ĐA 2 dòng is_variant_axis=true / category — chỉ service kiểm, không có ràng buộc DB']
  sort_order int [default: 0]
  Note: 'Mẫu thuộc tính theo ngành hàng. UQ (category_id, attribute_id)'
}

Table catalog.audit_logs {
  id uuid [pk]
  actor_user_id uuid
  actor_email varchar(255)
  action varchar(80)
  module_code varchar(40)
  entity_type varchar(80)
  entity_id varchar(64)
  entity_code varchar(100)
  request_id varchar(64)
  idempotency_key varchar(128)
  before_summary jsonb
  after_summary jsonb
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz
}
Table catalog.outbox_events {
  id uuid [pk]
  event_type varchar(80)
  event_version varchar(10)
  aggregate_type varchar(80)
  aggregate_id varchar(64)
  payload jsonb
  status varchar(20)
  retry_count int
  next_attempt_at timestamptz
  error_message text
  request_id varchar(64)
  processed_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}

Ref: catalog.categories.parent_id > catalog.categories.id
Ref: catalog.attribute_values.attribute_id > catalog.attributes.id
Ref: catalog.dynamic_attribute_values.attribute_id > catalog.dynamic_attributes.id
Ref: catalog.category_attributes.category_id > catalog.categories.id
Ref: catalog.category_attributes.attribute_id > catalog.dynamic_attributes.id

// ===================================================== product (PLAN-0004, PLAN-0014 bước 5, PLAN-0016, PLAN-0017)

Table product.products {
  id uuid [pk]
  slug varchar(160) [note: 'UQ partial sống']
  name varchar(200)
  shop_id uuid [not null, note: 'PLAN-0014 bước 5: gian hàng sở hữu sản phẩm (shop.shops.id — không FK xuyên schema). Migration 20260929084707 backfill toàn bộ sản phẩm cũ vào FITLY Official (00000000-0000-0000-0000-000000000001)']
  category_id uuid [note: 'catalog.categories.id — không FK xuyên schema']
  category_slug varchar(120) [note: 'snapshot, worker đồng bộ khi catalog đổi slug']
  gender varchar(10) [note: 'nam · nu · unisex — chỉ có nghĩa với category attribute_mode=legacy_fashion']
  short_description varchar(500)
  description text
  material varchar(200) [note: 'chỉ có nghĩa với legacy_fashion']
  care jsonb [note: 'string[] — chỉ có nghĩa với legacy_fashion']
  base_price numeric(14,0)
  list_price numeric(14,0) [note: 'giá gốc (gạch) khi giảm']
  status varchar(20) [note: 'draft · active · hidden']
  is_new boolean
  is_featured boolean
  tags jsonb [note: 'string[] — new, sale…']
  sold_count int
  review_count int
  avg_rating numeric(3,2)
  view_count int
  published_at timestamptz
  search_vector tsvector [note: 'trigger; GIN']
  created_at timestamptz
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  version int
  is_deleted boolean
  Note: 'index shop_id (products_shop_id_idx). Thuộc tính ngành hàng mới (attribute_mode=dynamic) nằm ở product_attribute_values; sản phẩm thời trang thì bảng đó rỗng'
}

Table product.product_variants {
  id uuid [pk]
  product_id uuid
  shop_id uuid [not null, note: 'PLAN-0014 bước 5: đồng bộ products.shop_id (backfill qua JOIN)']
  sku varchar(64) [note: 'UQ partial THEO GIAN HÀNG: uq_product_variants_shop_sku_active (shop_id, sku) WHERE is_deleted=false — migration 20261003140000 thay cho unique(sku) toàn sàn và unique(shop_id, sku) tính cả xoá mềm; hai shop được trùng SKU, SKU xoá mềm dùng lại được. Prisma không khai @@unique cho nó (service kiểm trước). Thời trang sinh bằng makeSku(slug, màu, size)']
  color_code varchar(40) [null, note: 'NULL với biến thể ngành dynamic (dùng product_variant_options) — migration 20260929120000 bỏ NOT NULL']
  color_name varchar(120) [null, note: 'snapshot từ catalog; NULL với ngành dynamic']
  color_hex varchar(9) [null]
  size_code varchar(40) [null, note: 'NULL với biến thể ngành dynamic']
  price numeric(14,0) [null, note: 'NULL = base_price']
  stock int [note: 'tồn thô']
  reserved int [note: 'đang giữ cho đơn; CHECK 0 ≤ reserved ≤ stock']
  is_active boolean
  created_at timestamptz
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  version int
  is_deleted boolean
  Note: 'UQ (product_id, color_code, size_code) — với NULL (ngành dynamic) Postgres coi mỗi dòng là khác nhau nên unique này KHÔNG chặn trùng tổ hợp trục dynamic; service kiểm. Index sku, shop_id. CHECK ck_product_variants_stock_nonneg'
}

// PLAN-0016 (migration 20260929120000). attribute_id / attribute_value_id trỏ sang schema catalog (dynamic_attributes /
// dynamic_attribute_values) bằng id trần — KHÔNG FK xuyên schema.

Table product.product_attribute_values {
  id uuid [pk]
  product_id uuid
  attribute_id uuid [note: 'catalog.dynamic_attributes.id']
  attribute_value_id uuid [null, note: 'catalog.dynamic_attribute_values.id; NULL khi nhập tay']
  custom_value varchar(255) [null, note: 'nhập tay khi input_type = text | number']
  Note: 'Thuộc tính cấp sản phẩm, KHÔNG tạo biến thể (vd Xuất xứ, Bảo hành). UQ (product_id, attribute_id)'
}

Table product.product_variant_options {
  id uuid [pk]
  variant_id uuid
  attribute_id uuid [note: 'catalog.dynamic_attributes.id']
  attribute_value_id uuid [note: 'catalog.dynamic_attribute_values.id']
  display_value varchar(100) [note: 'snapshot tên hiển thị lúc tạo (vd 128GB) — đổi tên giá trị gốc không làm lệch đơn cũ']
  Note: 'Một trục biến thể của một variant (thay color_code/size_code cho ngành dynamic); tối đa 2 dòng / variant (chỉ service kiểm). UQ (variant_id, attribute_id)'
}

Table product.product_images {
  id uuid [pk]
  product_id uuid
  url varchar(500)
  public_id varchar(255)
  color_code varchar(40) [null, note: 'ảnh thuộc màu; NULL = chung']
  alt varchar(200)
  sort_order int
  is_primary boolean [note: 'UQ partial một ảnh chính / sản phẩm']
  created_at timestamptz
  created_by uuid
}

Table product.stock_receipts {
  id uuid [pk]
  code varchar(30) [unique, note: 'PNyymm00001']
  supplier_name varchar(200)
  note varchar(500)
  status varchar(20) [note: 'draft · posted · cancelled']
  total_cost numeric(14,0)
  shop_id uuid [null, note: 'PLAN-0017 (migration 20261003110000): phiếu của gian hàng nào (vendor tự nhập kho); NULL = phiếu của sàn. Mọi dòng phải là biến thể cùng shop_id (service kiểm). Phiếu cũ backfill = FITLY Official']
  posted_at timestamptz
  posted_by uuid
  created_at timestamptz
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  version int
  is_deleted boolean
  Note: 'index (shop_id, created_at DESC) và (status, created_at DESC)'
}

Table product.stock_receipt_items {
  id uuid [pk]
  receipt_id uuid
  variant_id uuid
  sku varchar(64)
  quantity int
  unit_cost numeric(14,0)
  Note: 'UQ (receipt_id, variant_id)'
}

Table product.stock_movements {
  id uuid [pk]
  product_id uuid
  variant_id uuid
  type varchar(20) [note: 'RECEIPT · ADJUST · RESERVE · RELEASE · SALE · RETURN']
  quantity int [note: '+/-']
  stock_after int
  ref_type varchar(40)
  ref_id varchar(64)
  note varchar(255)
  actor_user_id uuid
  created_at timestamptz
}

Table product.audit_logs {
  id uuid [pk]
  actor_user_id uuid
  actor_email varchar(255)
  action varchar(80)
  module_code varchar(40)
  entity_type varchar(80)
  entity_id varchar(64)
  entity_code varchar(100)
  request_id varchar(64)
  idempotency_key varchar(128)
  before_summary jsonb
  after_summary jsonb
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz
}
Table product.outbox_events {
  id uuid [pk]
  event_type varchar(80)
  event_version varchar(10)
  aggregate_type varchar(80)
  aggregate_id varchar(64)
  payload jsonb
  status varchar(20)
  retry_count int
  next_attempt_at timestamptz
  error_message text
  request_id varchar(64)
  processed_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}
Table product.processed_events {
  id uuid [pk]
  event_id uuid
  event_type varchar(80)
  handler varchar(120)
  processed_at timestamptz
  Note: 'UQ (event_id, handler)'
}
Table product.idempotency_keys {
  id uuid [pk]
  scope varchar(60)
  actor_key varchar(64)
  idempotency_key varchar(128)
  request_hash varchar(64)
  status varchar(20)
  response_status int
  response_body jsonb
  result_ref varchar(64)
  expires_at timestamptz
  created_at timestamptz
  Note: 'UQ (scope, actor_key, idempotency_key)'
}

Ref: product.product_variants.product_id > product.products.id
Ref: product.product_images.product_id > product.products.id
Ref: product.product_attribute_values.product_id > product.products.id
Ref: product.product_variant_options.variant_id > product.product_variants.id
Ref: product.stock_receipt_items.receipt_id > product.stock_receipts.id
Ref: product.stock_receipt_items.variant_id - product.product_variants.id
Ref: product.stock_movements.variant_id > product.product_variants.id

// ===================================================== cart (PLAN-0005)

Table cart.carts {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [unique, not null]
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table cart.cart_items {
  id uuid [pk, default: `gen_random_uuid()`]
  cart_id uuid [not null]
  variant_id uuid [not null]
  product_id uuid [not null]
  shop_id uuid [not null, note: 'PLAN-0014 bước 6: denormalize từ product.shop_id lúc thêm giỏ — để tách giỏ theo shop khi checkout']
  quantity int [not null]
  selected bool [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'UQ (cart_id, variant_id)'
}

Table cart.wishlists {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  product_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'UQ (user_id, product_id)'
}

Ref: cart.cart_items.cart_id > cart.carts.id


// ===================================================== system (PLAN-0010)

Table system.settings {
  key varchar(80) [pk]
  value jsonb [not null]
  group_code varchar(40) [not null, default: 'general']
  description varchar(255) [null]
  is_public bool [not null, default: false]
  updated_at timestamptz [not null, default: `now()`]
  updated_by uuid [null]
}

Table system.provinces {
  code varchar(10) [pk]
  name varchar(100) [not null]
  region varchar(20) [not null]
  shipping_fee numeric(14,0) [not null]
  sort_order int [not null, default: 0]
  is_active bool [not null, default: true]
  updated_at timestamptz [not null, default: `now()`]
}

Table system.banners {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(200) [not null]
  subtitle varchar(300) [null]
  image_url varchar(500) [not null]
  image_public_id varchar(255) [null]
  link_url varchar(500) [null]
  position varchar(20) [not null, default: 'hero']
  sort_order int [not null, default: 0]
  is_active bool [not null, default: true]
  starts_at timestamptz [null]
  ends_at timestamptz [null]
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid [null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by uuid [null]
  is_deleted bool [not null, default: false]
}

Table system.notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  type varchar(40) [not null]
  title varchar(200) [not null]
  content varchar(1000) [null]
  link varchar(500) [null]
  payload jsonb [null]
  read_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
}

Table system.contact_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(120) [not null]
  email varchar(255) [not null]
  phone varchar(20) [null]
  message varchar(2000) [not null]
  status varchar(20) [not null, default: 'new']
  reply varchar(2000) [null]
  handled_by uuid [null]
  handled_at timestamptz [null]
  ip_address varchar(45) [null]
  created_at timestamptz [not null, default: `now()`]
}

Table system.faqs {
  id uuid [pk, default: `gen_random_uuid()`]
  question varchar(300) [not null]
  answer text [not null]
  group_code varchar(40) [not null, default: 'general']
