}


// ===================================================== promotion (PLAN-0008, PLAN-0017)

Table promotion.promotions {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(40) [not null, note: 'UQ partial uq_promotions_code_active: upper(code) WHERE is_deleted=false — duy nhất TOÀN SÀN, voucher sàn và voucher mọi shop dùng chung không gian mã']
  name varchar(200) [not null]
  description varchar(500) [null]
  type varchar(20) [not null]
  value numeric(14,2) [not null, default: 0]
  max_discount numeric(14,0) [null]
  min_order_amount numeric(14,0) [not null, default: 0]
  usage_limit int [null]
  usage_limit_per_user int [null]
  used_count int [not null, default: 0]
  applies_to varchar(20) [not null, default: 'all']
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  is_active bool [not null, default: true]
  is_public bool [not null, default: true]
  scope varchar(10) [not null, default: 'platform', note: 'PLAN-0017: platform = voucher SÀN (áp trên tổng OrderGroup) | shop = voucher GIAN HÀNG (chỉ áp cho đơn con của đúng shop_id)']
  shop_id uuid [null, note: 'shop.shops.id (không FK xuyên schema); NULL với voucher sàn']
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid [null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by uuid [null]
  is_deleted bool [not null, default: false]
  Note: 'CHECK chk_promotions_scope: (scope=platform AND shop_id IS NULL) OR (scope=shop AND shop_id IS NOT NULL). CHECK ck_promotions_used_le_limit: usage_limit IS NULL OR used_count <= usage_limit. Index (scope, shop_id) và (is_active, starts_at, ends_at). Migration 20261003100000'
}

Table promotion.promotion_targets {
  id uuid [pk, default: `gen_random_uuid()`]
  promotion_id uuid [not null]
  target_type varchar(20) [not null]
  target_ref varchar(160) [not null]
  Note: 'UQ (promotion_id, target_type, target_ref)'
}

Table promotion.promotion_usages {
  id uuid [pk, default: `gen_random_uuid()`]
  promotion_id uuid [not null]
  user_id uuid [not null]
  order_code varchar(30) [not null]
  discount_amount numeric(14,0) [not null]
  created_at timestamptz [not null, default: `now()`]
  released_at timestamptz [null]
  Note: 'UQ (promotion_id, order_code)'
}

Table promotion.audit_logs {
  id uuid [pk]
  actor_user_id uuid
  actor_email varchar(255)
  action varchar(80)
  module_code varchar(40)
  entity_type varchar(80)
  entity_id varchar(64)
  entity_code varchar(100)
  request_id varchar(64)
  idempotency_key varchar(128)
  before_summary jsonb
  after_summary jsonb
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz
}

Ref: promotion.promotion_targets.promotion_id > promotion.promotions.id
Ref: promotion.promotion_usages.promotion_id > promotion.promotions.id


// ===================================================== order (PLAN-0006, PLAN-0014 bước 7, PLAN-0017)

// Đơn CHA: 1 lần checkout → 1 OrderGroup + N Order con (mỗi shop 1 Order, state machine/thanh toán riêng như cũ).
// Không có trạng thái/lifecycle riêng. Đơn single-shop cũ được backfill thành nhóm 1-đơn (mã = DHN + phần sau 'DH' của mã đơn).
Table order.order_groups {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(30) [unique, not null, note: 'DHN + yymmdd + 4 số — order_group_sequences riêng']
  user_id uuid [not null]
  recipient_name varchar(120) [not null]
  recipient_phone varchar(20) [not null]
  shipping_address varchar(500) [not null, note: 'snapshot địa chỉ (trùng lặp có chủ đích với từng Order con)']
  subtotal numeric(14,0) [not null, note: 'tổng cả giỏ = cộng dồn các Order con lúc tạo']
  shipping_fee numeric(14,0) [not null]
  discount numeric(14,0) [not null, default: 0]
  total numeric(14,0) [not null]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid [null]
  Note: 'index (user_id, created_at DESC). Không có updated_at / version / is_deleted'
}

Table order.order_group_sequences {
  day varchar(6) [pk]
  counter int [not null, default: 0]
  Note: 'bộ đếm mã OrderGroup theo ngày, tách khỏi order_sequences'
}

Table order.orders {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(30) [unique, not null]
  user_id uuid [not null]
  shop_id uuid [not null, note: 'gian hàng sở hữu đơn NÀY — mỗi Order thuộc đúng 1 shop (shop.shops.id, không FK xuyên schema). Index (shop_id, created_at DESC)']
  order_group_id uuid [not null, note: 'FK order.order_groups — mọi Order luôn thuộc đúng 1 OrderGroup (ON DELETE RESTRICT)']
  commission_rate_snapshot numeric(5,2) [not null, note: '% hoa hồng sàn ĐÓNG BĂNG lúc đặt (đọc shop.shops.commission_rate); đơn cũ backfill từ hoa hồng hiện tại của shop. Dùng cho đối soát payout']
  status varchar(20) [not null, default: 'pending']
  payment_method_code varchar(20) [not null]
  payment_status varchar(20) [not null, default: 'unpaid']
  recipient_name varchar(120) [not null]
  recipient_phone varchar(20) [not null]
  province_code varchar(10) [null]
  province_name varchar(100) [not null]
  district_name varchar(100) [null]
  ward_name varchar(100) [null]
  street varchar(255) [not null]
  shipping_address varchar(500) [not null]
  customer_note varchar(500) [null]
  subtotal numeric(14,0) [not null]
  shipping_fee numeric(14,0) [not null]
  discount numeric(14,0) [not null, default: 0, note: 'tổng giảm = shop_discount + platform_discount (không có CHECK ở DB)']
  shop_discount numeric(14,0) [not null, default: 0, note: 'PLAN-0017 (migration 20261003120000): phần giảm do voucher GIAN HÀNG — shop chịu']
  platform_discount numeric(14,0) [not null, default: 0, note: 'phần giảm do voucher SÀN — sàn chịu: đối soát/hoa hồng tính trên total + platform_discount, sàn hoàn phần này cho shop. Đơn cũ có promotion_code backfill = discount']
  promotion_code varchar(40) [null, note: 'voucher SÀN']
  promotion_name varchar(200) [null]
  shop_promotion_code varchar(40) [null, note: 'voucher GIAN HÀNG (đơn con mang tối đa 1 voucher sàn + 1 voucher shop)']
  shop_promotion_name varchar(200) [null]
  total numeric(14,0) [not null]
  item_count int [not null]
  cancel_reason varchar(255) [null]
  cancelled_by uuid [null]
  tracking_url varchar(500) [null]
  payment_expires_at timestamptz [null]
  confirmed_at timestamptz [null]
  packed_at timestamptz [null]
  shipped_at timestamptz [null]
  delivered_at timestamptz [null]
  completed_at timestamptz [null]
  cancelled_at timestamptz [null]
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid [null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by uuid [null]
  is_deleted bool [not null, default: false]
  Note: 'CHECK ck_orders_money_nonneg: subtotal, shipping_fee, discount, total >= 0. Index (user_id, created_at DESC), (status, created_at DESC), (payment_status, payment_expires_at), (shop_id, created_at DESC), (order_group_id)'
}

Table order.order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  shop_id uuid [not null, note: 'đồng bộ order.orders.shop_id (đơn con chỉ chứa hàng của 1 shop) — chép ra để báo cáo theo shop khỏi JOIN. Index shop_id']
  variant_id uuid [not null]
  product_id uuid [not null]
  slug varchar(160) [not null]
  name varchar(200) [not null]
  image_url varchar(500) [null]
  color varchar(120) [not null]
  size varchar(40) [not null]
  sku varchar(64) [not null]
  quantity int [not null]
  unit_price numeric(14,0) [not null]
  line_total numeric(14,0) [not null]
  reviewed bool [not null, default: false]
}

Table order.order_status_histories {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  from_status varchar(20) [null]
  to_status varchar(20) [not null]
  note varchar(500) [null]
  actor_user_id uuid [null]
  created_at timestamptz [not null, default: `now()`]
}

Table order.return_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  order_code varchar(30) [not null]
  user_id uuid [not null]
  status varchar(20) [not null, default: 'requested']
  reason varchar(255) [not null]
  detail varchar(1000) [null]
  reject_reason varchar(500) [null]
  refund_amount numeric(14,0) [not null]
  evidence jsonb [not null, default: '[]']
  processed_by uuid [null]
  processed_at timestamptz [null]
  refunded_at timestamptz [null]
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  updated_by uuid [null]
}

Table order.return_request_items {
  id uuid [pk, default: `gen_random_uuid()`]
  return_id uuid [not null]
  order_item_id uuid [not null]
  variant_id uuid [not null]
  name varchar(200) [not null]
  color varchar(120) [not null]
  size varchar(40) [not null]
  quantity int [not null]
  image_url varchar(500) [null]
  unit_price numeric(14,0) [not null]
  Note: 'UQ (return_id, order_item_id)'
}

Table order.order_sequences {
  day varchar(6) [pk]
  counter int [not null, default: 0]
}

Table order.audit_logs {
  id uuid [pk]
  actor_user_id uuid
  actor_email varchar(255)
  action varchar(80)
  module_code varchar(40)
  entity_type varchar(80)
  entity_id varchar(64)
  entity_code varchar(100)
  request_id varchar(64)
  idempotency_key varchar(128)
  before_summary jsonb
  after_summary jsonb
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz
}
Table order.outbox_events {
  id uuid [pk]
  event_type varchar(80)
  event_version varchar(10)
  aggregate_type varchar(80)
  aggregate_id varchar(64)
  payload jsonb
  status varchar(20)
  retry_count int
  next_attempt_at timestamptz
  error_message text
  request_id varchar(64)
  processed_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}
Table order.processed_events {
  id uuid [pk]
  event_id uuid
  event_type varchar(80)
  handler varchar(120)
  processed_at timestamptz
  Note: 'UQ (event_id, handler)'
}
Table order.idempotency_keys {
  id uuid [pk]
  scope varchar(60)
  actor_key varchar(64)
  idempotency_key varchar(128)
  request_hash varchar(64)
  status varchar(20)
  response_status int
  response_body jsonb
  result_ref varchar(64)
  expires_at timestamptz
  created_at timestamptz
  Note: 'UQ (scope, actor_key, idempotency_key)'
}

Ref: order.orders.order_group_id > order.order_groups.id
Ref: order.order_items.order_id > order.orders.id
Ref: order.order_status_histories.order_id > order.orders.id
Ref: order.return_requests.order_id > order.orders.id
Ref: order.return_request_items.return_id > order.return_requests.id


// ===================================================== payment (PLAN-0007, PLAN-0017)

Table payment.payment_methods {
  code varchar(20) [pk, note: 'cod | bank_transfer | vnpay | payos. `payos` bật trong DB nhưng khách chỉ thấy khi backend có khoá PayOS (isMethodActive)']
  name varchar(120) [not null]
  description varchar(300) [null]
  kind varchar(20) [not null]
  is_active bool [not null, default: true]
  sort_order int [not null, default: 0]
  config jsonb [null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by uuid [null]
}

Table payment.payments {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, note: 'id đơn CON (order.orders.id, không FK xuyên schema) — payment gắn từng đơn con, KHÔNG gắn order_groups; mỗi đơn con thanh toán/hoàn tiền riêng']
  order_code varchar(30) [not null]
  user_id uuid [not null]
  method_code varchar(20) [not null]
  amount numeric(14,0) [not null]
  status varchar(20) [not null, default: 'pending']
  transaction_code varchar(64) [null]
  bank_code varchar(20) [null]
  card_brand varchar(20) [null]
  card_last4 varchar(4) [null]
  transfer_content varchar(60) [null]
  refunded_amount numeric(14,0) [not null, default: 0]
  gateway_response jsonb [null, note: 'payload webhook gốc của cổng; PayOS: có counterAccountBankId/counterAccountNumber (chỉ 3 ngân hàng) để hoàn tiền tự động qua Lệnh chi']
  paid_at timestamptz [null]
  expires_at timestamptz [null]
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid [null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by uuid [null]
  Note: 'UQ partial uq_payments_order_live: (order_id) WHERE status IN pending/processing/paid — mỗi đơn tối đa 1 giao dịch thanh toán sống'
}

Table payment.payment_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  payment_id uuid [not null]
  type varchar(20) [not null, note: 'create_url | ipn | payos_webhook | return | query | refund | manual_confirm | cod_collect']
  status varchar(20) [not null]
  amount numeric(14,0) [null]
  provider_ref varchar(120) [null, note: 'VNPay: vnp_TxnRef; PayOS: orderCode PayOS (số, Date.now()*1000 + random(1000)) — cùng (type, provider_ref) là khoá chống ghi đôi']
  raw_request jsonb [null]
  raw_response jsonb [null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'UQ partial uq_payment_transactions_provider_ref: (type, provider_ref) WHERE provider_ref IS NOT NULL — IPN/return trùng không cộng tiền hai lần'
}

Table payment.bank_transfer_confirmations {
  id uuid [pk, default: `gen_random_uuid()`]
  payment_id uuid [not null]
  amount numeric(14,0) [not null]
  bank_ref varchar(120) [null]
  note varchar(500) [null]
  confirmed_by uuid [not null]
  confirmed_at timestamptz [not null, default: `now()`]
}

Table payment.refunds {
  id uuid [pk, default: `gen_random_uuid()`]
  payment_id uuid [not null]
  order_code varchar(30) [not null]
  return_request_id uuid [null]
  amount numeric(14,0) [not null]
  status varchar(20) [not null, default: 'requested']
  method varchar(20) [not null]
  provider_ref varchar(120) [null]
  reason varchar(255) [null]
  note varchar(500) [null]
  requested_by uuid [null]
  processed_by uuid [null]
  processed_at timestamptz [null]
  kind varchar(20) [not null, default: 'order', note: 'order = hoàn theo đơn | duplicate_payment = hoàn khoản khách trả trùng (không đổi payment_status của đơn, không đảo hoa hồng, không vào báo cáo hoàn). CHECK chk_refunds_kind']
  gateway_attempted_at timestamptz [null, note: 'Ghi TRƯỚC khi gọi cổng VNPay (không có idempotency-key). Còn dấu mà chưa có provider_ref = chưa rõ cổng đã hoàn chưa => failed + needsReconcile, người xử lý đối chiếu rồi mới gọi lại']
  shop_id uuid [null, note: 'PLAN-0017: snapshot gian hàng của đơn bị hoàn (đối soát payout trừ hoàn tiền đúng shop); backfill từ order.orders theo order_code, đơn không tìm thấy = NULL. Index shop_id']
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ----- PLAN-0017 (migration 20261003100000): ví quỹ COD + đối soát (payout) theo gian hàng. shop_id = shop.shops.id (id trần).

Table payment.shop_wallets {
  id uuid [pk, default: `gen_random_uuid()`]
  shop_id uuid [unique, not null, note: '1-1 với shop. Migration tạo sẵn ví số dư 0 cho mọi shop đã duyệt']
  balance numeric(14,0) [not null, default: 0, note: 'CÓ THỂ ÂM. balance <= 0 thì service tắt shop.shops.cod_enabled (qua gateway sang module shop)']
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Ví quỹ COD: mỗi đơn COD hoàn tất trừ đúng hoa hồng khỏi ví'
}

Table payment.shop_wallet_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  wallet_id uuid [not null]
  shop_id uuid [not null]
  type varchar(20) [not null, note: 'cod_commission | deposit | adjust | cod_refund — CHECK chk_shop_wallet_tx_type (cod_refund thêm ở migration 20261003160000: hoàn tiền đơn COD đã thu, ghi nợ ví số hoàn và hoàn lại hoa hồng tương ứng)']
  order_code varchar(30) [null, note: 'mã đơn; với cod_refund là khoá RF-<26 ký tự đầu của refund id> (chống ghi hai lần); NULL với deposit/adjust']
  amount numeric(14,0) [not null, note: 'âm = trừ khỏi ví (hoa hồng; cod_refund = hoa hồng hoàn lại - số hoàn), dương = cộng (nộp quỹ / điều chỉnh; cod_commission cũng có thể dương khi sàn hoàn voucher sàn lớn hơn hoa hồng)']
  balance_after numeric(14,0) [not null]
  note varchar(500) [null]
  created_by uuid [null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'SỔ CÁI APPEND-ONLY (không update/xoá; điều chỉnh = thêm dòng bù). UQ (shop_id, type, order_code) — gọi completed hai lần không trừ hoa hồng hai lần (order_code NULL thì unique không ràng). Index (shop_id, created_at DESC)'
}

Table payment.shop_wallet_deposit_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  shop_id uuid [not null]
  amount numeric(14,0) [not null, note: 'CHECK chk_shop_wallet_deposit_status: amount > 0']
  status varchar(20) [not null, default: 'pending', note: 'pending | approved | rejected — CHECK chk_shop_wallet_deposit_status; sàn duyệt thì cộng ví']
  proof_url varchar(500) [null]
  note varchar(500) [null]
  decided_by uuid [null]
  decided_at timestamptz [null]
  decide_note varchar(500) [null]
  created_by uuid [null]
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Shop xin nộp thêm quỹ khi ví về 0/âm bị khoá COD. Index (shop_id, status), (status, created_at DESC)'
}

Table payment.shop_payouts {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(30) [unique, not null]
  shop_id uuid [not null]
  period_start timestamptz [not null]
  period_end timestamptz [not null]
  gross_revenue numeric(14,0) [not null]
  commission numeric(14,0) [not null]
  refund_amount numeric(14,0) [not null]
  carried_debt numeric(14,0) [not null, default: 0, note: 'nợ mang từ kỳ trước']
  net_payout numeric(14,0) [not null, note: '= gross_revenue - commission - refund_amount - carried_debt; CÓ THỂ ÂM (khi đó không chi, nợ âm sang kỳ sau)']
  status varchar(20) [not null, default: 'pending', note: 'pending | processing | paid | failed | carried (net < 0: không chi, mang nợ) | settled (net = 0: không có gì để chi) — CHECK chk_shop_payouts_status (carried/settled thêm ở migration 20261003130000); một chiều, không có đường paid về pending']
  provider_ref varchar(120) [null, note: 'mã giao dịch chi PayOS / mã chuyển khoản tay — chống chi trùng, tra soát']
  fail_reason varchar(500) [null]
  bank_snapshot jsonb [null, note: 'snapshot tài khoản nhận lúc chạy kỳ (đổi hồ sơ shop sau đó không làm lệch chứng từ)']
  paid_at timestamptz [null]
  created_by uuid [null]
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Kỳ đối soát một shop, số liệu ĐÓNG BĂNG lúc chạy kỳ. UQ (shop_id, period_start, period_end). Index (status, created_at DESC)'
}

Table payment.shop_payout_lines {
  id uuid [pk, default: `gen_random_uuid()`]
  payout_id uuid [not null]
  order_code varchar(30) [not null, note: 'kind=sale: mã đơn | kind=refund: khoá RF-<26 ký tự đầu của refund id>']
  kind varchar(10) [not null, note: 'sale | refund — CHECK chk_shop_payout_lines_kind']
  gross numeric(14,0) [not null]
  commission numeric(14,0) [not null]
  Note: 'UQ (order_code, kind) TOÀN BẢNG — một đơn/hoàn tiền không bao giờ bị tính vào hai kỳ. Index payout_id'
}

Table payment.audit_logs {
  id uuid [pk]
  actor_user_id uuid
  actor_email varchar(255)
  action varchar(80)
  module_code varchar(40)
  entity_type varchar(80)
  entity_id varchar(64)
  entity_code varchar(100)
  request_id varchar(64)
  idempotency_key varchar(128)
  before_summary jsonb
  after_summary jsonb
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz
}
Table payment.outbox_events {
  id uuid [pk]
  event_type varchar(80)
  event_version varchar(10)
  aggregate_type varchar(80)
  aggregate_id varchar(64)
  payload jsonb
  status varchar(20)
  retry_count int
  next_attempt_at timestamptz
  error_message text
  request_id varchar(64)
  processed_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}
Table payment.processed_events {
  id uuid [pk]
  event_id uuid
  event_type varchar(80)
  handler varchar(120)
  processed_at timestamptz
  Note: 'UQ (event_id, handler)'
}

Ref: payment.payment_transactions.payment_id > payment.payments.id
Ref: payment.bank_transfer_confirmations.payment_id > payment.payments.id
Ref: payment.refunds.payment_id > payment.payments.id
Ref: payment.shop_wallet_transactions.wallet_id > payment.shop_wallets.id
Ref: payment.shop_payout_lines.payout_id > payment.shop_payouts.id


// ===================================================== review (PLAN-0009, PLAN-0014 bước 9)

Table review.reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  product_slug varchar(160) [not null]
  product_name varchar(200) [not null]
  shop_id uuid [not null, note: 'PLAN-0014 bước 9: snapshot product.shop_id lúc tạo review (cho vendor trả lời review của shop mình; backfill qua JOIN products). Index shop_id']
  user_id uuid [not null]
  author_name varchar(120) [not null]
  avatar_url varchar(500) [null]
  order_code varchar(30) [null]
  order_item_id uuid [null]
  variant_label varchar(160) [null]
  rating int [not null]
  content varchar(2000) [not null]
  media jsonb [not null, default: '[]']
  status varchar(20) [not null, default: 'approved']
  moderation_note varchar(500) [null]
  moderated_by uuid [null]
  moderated_at timestamptz [null]
  helpful_count int [not null, default: 0]
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  is_deleted bool [not null, default: false]
  Note: 'UQ (user_id, order_item_id). CHECK ck_reviews_rating: rating BETWEEN 1 AND 5'
}

Table review.review_replies {
  id uuid [pk, default: `gen_random_uuid()`]
  review_id uuid [not null]
  staff_user_id uuid [not null]
  staff_name varchar(120) [not null, note: 'Dữ liệu lịch sử (có thể là họ tên nhân viên) — API KHÔNG đọc cột này, tên hiển thị tính từ author_kind']
  author_kind varchar(20) [not null, default: 'platform', note: 'shop = tên shop hiện tại | platform = Sàn FITLY. CHECK ck_review_replies_author_kind']
  content varchar(2000) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table review.audit_logs {
  id uuid [pk]
  actor_user_id uuid
  actor_email varchar(255)
  action varchar(80)
  module_code varchar(40)
  entity_type varchar(80)
  entity_id varchar(64)
  entity_code varchar(100)
  request_id varchar(64)
  idempotency_key varchar(128)
  before_summary jsonb
  after_summary jsonb
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz
}
Table review.outbox_events {
  id uuid [pk]
  event_type varchar(80)
  event_version varchar(10)
  aggregate_type varchar(80)
  aggregate_id varchar(64)
  payload jsonb
  status varchar(20)
  retry_count int
  next_attempt_at timestamptz
  error_message text
  request_id varchar(64)
  processed_at timestamptz
  created_at timestamptz
  updated_at timestamptz
}
Table review.processed_events {
  id uuid [pk]
  event_id uuid
  event_type varchar(80)
  handler varchar(120)
  processed_at timestamptz
  Note: 'UQ (event_id, handler)'
}

Ref: review.review_replies.review_id > review.reviews.id


// ===================================================== reporting (PLAN-0011)

Table reporting.daily_sales {
  day varchar(10) [pk]
  order_count int [not null, default: 0]
  paid_count int [not null, default: 0]
  cancelled_count int [not null, default: 0]
  revenue numeric(14,0) [not null, default: 0]
  discount numeric(14,0) [not null, default: 0]
  shipping_fee numeric(14,0) [not null, default: 0]
  items_sold int [not null, default: 0]
  new_customers int [not null, default: 0]
  refunded numeric(14,0) [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]
}


// ===================================================== ai (PLAN-0012/0013)

Table ai.product_embeddings {
  product_id uuid [pk]
  product_slug varchar(160) [not null]
  embedding vector(1536) [null]
  source_hash varchar(64) [not null]
  model varchar(60) [not null]
  status varchar(20) [not null, default: 'pending']
  error varchar(500) [null]
  updated_at timestamptz [not null, default: `now()`]
}

Table ai.documents {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(200) [not null]
  content text [not null]
  kind varchar(20) [not null, default: 'policy']
  status varchar(20) [not null, default: 'pending']
  error varchar(500) [null]
  is_active bool [not null, default: true]
  version int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  created_by uuid [null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by uuid [null]
  is_deleted bool [not null, default: false]
}

Table ai.document_chunks {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null]
  chunk_index int [not null]
  content text [not null]
  embedding vector(1536) [null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'UQ (document_id, chunk_index)'
}

Table ai.chat_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [null]
  guest_key varchar(64) [null]
  title varchar(200) [null]
  message_count int [not null, default: 0]
  last_message_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
}

Table ai.chat_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null]
  role varchar(20) [not null]
  content text [not null]
  product_ids jsonb [not null, default: '[]']
  source varchar(10) [not null, default: 'rule']
  tokens_in int [not null, default: 0]
  tokens_out int [not null, default: 0]
  meta jsonb [null]
  created_at timestamptz [not null, default: `now()`]
}

Table ai.support_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [null]
  user_id uuid [null]
  email varchar(255) [null]
  summary varchar(1000) [not null]
  status varchar(20) [not null, default: 'open']
  assigned_to uuid [null]
  resolved_by uuid [null]
  resolved_at timestamptz [null]
  note varchar(1000) [null]
  created_at timestamptz [not null, default: `now()`]
}

Table ai.usage_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  feature varchar(40) [not null]
  provider varchar(20) [not null]
  model varchar(80) [not null]
  tokens_in int [not null, default: 0]
  tokens_out int [not null, default: 0]
  cost_estimate numeric(12,6) [not null, default: 0]
  duration_ms int [not null, default: 0]
  success bool [not null, default: true]
  user_id uuid [null]
  created_at timestamptz [not null, default: `now()`]
}

Table ai.try_on_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [null]
  guest_key varchar(64) [null]
  product_id uuid [not null]
  product_name varchar(200) [not null]
  garment_image_url varchar(500) [not null]
  person_image_url varchar(500) [not null]
  person_public_id varchar(255) [null]
  category varchar(20) [not null, default: 'upper_body']
  status varchar(20) [not null, default: 'queued']
  provider_job_id varchar(120) [null]
  result_url varchar(500) [null]
  result_public_id varchar(255) [null]
  error varchar(500) [null]
  attempts int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz [null]
  finished_at timestamptz [null]
}

Table ai.style_analyses {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [null]
  guest_key varchar(64) [null]
  image_url varchar(500) [not null]
  image_public_id varchar(255) [null]
  result jsonb [not null]
  product_ids jsonb [not null, default: '[]']
  source varchar(10) [not null, default: 'rule']
  created_at timestamptz [not null, default: `now()`]
}

Table ai.review_summaries {
  product_id uuid [pk]
  summary varchar(2000) [not null]
  pros jsonb [not null, default: '[]']
  cons jsonb [not null, default: '[]']
  review_count int [not null]
  model varchar(80) [not null]
  updated_at timestamptz [not null, default: `now()`]
}

Table ai.moderation_flags {
  review_id uuid [pk]
  label varchar(20) [not null]
  score numeric(4,3) [not null]
  reason varchar(500) [null]
  model varchar(80) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table ai.product_view_events {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [null]
  guest_key varchar(64) [null]
  product_id uuid [not null]
  event_type varchar(15) [not null, default: 'view']
  source varchar(30) [null]
  created_at timestamptz [not null, default: `now()`]
}

Table ai.product_faqs {
  product_id uuid [pk]
  items jsonb [not null, default: '[]']
  source_hash varchar(64) [not null]
  status varchar(20) [not null, default: 'pending']
  model varchar(80) [null]
  error varchar(500) [null]
  updated_at timestamptz [not null, default: `now()`]
}

Table ai.audit_logs {
  id uuid [pk]
  actor_user_id uuid
  actor_email varchar(255)
  action varchar(80)
  module_code varchar(40)
  entity_type varchar(80)
  entity_id varchar(64)
  entity_code varchar(100)
  request_id varchar(64)
  idempotency_key varchar(128)
  before_summary jsonb
  after_summary jsonb
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz
}
Table ai.processed_events {
  id uuid [pk]
  event_id uuid
  event_type varchar(80)
  handler varchar(120)
  processed_at timestamptz
  Note: 'UQ (event_id, handler)'
}

Ref: ai.document_chunks.document_id > ai.documents.id
Ref: ai.chat_messages.session_id > ai.chat_sessions.id
