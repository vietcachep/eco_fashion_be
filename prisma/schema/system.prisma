// =====================================================================
// Module system (PLAN-0010) — schema "system": tham số vận hành, tỉnh/thành + phí ship, banner, thông báo trong-app,
// liên hệ, FAQ, trang chính sách. NotificationGateway (common) do module này cài.
// =====================================================================

model Setting {
  key         String   @id @db.VarChar(80)
  value       Json
  groupCode   String   @default("general") @map("group_code") @db.VarChar(40)
  description String?  @db.VarChar(255)
  /* Cho web bán hàng đọc (tên shop, hotline, freeship…) — không được để bí mật vào setting public. */
  isPublic    Boolean  @default(false) @map("is_public")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy   String?  @map("updated_by") @db.Uuid

  @@index([groupCode])
  @@map("settings")
  @@schema("system")
}

/* 63 tỉnh/thành — phí ship theo vùng; địa chỉ khách chụp mã + tên. */
model Province {
  code        String   @id @db.VarChar(10)
  name        String   @db.VarChar(100)
  /* Vùng để tính phí: hcm | mien-nam | mien-trung | mien-bac */
  region      String   @db.VarChar(20)
  shippingFee Decimal  @map("shipping_fee") @db.Decimal(14, 0)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("provinces")
  @@schema("system")
}

model Banner {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String    @db.VarChar(200)
  subtitle      String?   @db.VarChar(300)
  imageUrl      String    @map("image_url") @db.VarChar(500)
  imagePublicId String?   @map("image_public_id") @db.VarChar(255)
  linkUrl       String?   @map("link_url") @db.VarChar(500)
  /* hero (slider đầu trang) | promo (băng rôn giữa trang) */
  position      String    @default("hero") @db.VarChar(20)
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  startsAt      DateTime? @map("starts_at") @db.Timestamptz
  endsAt        DateTime? @map("ends_at") @db.Timestamptz
  version       Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy     String?   @map("updated_by") @db.Uuid
  isDeleted     Boolean   @default(false) @map("is_deleted")

  @@index([position, isActive, sortOrder])
  @@map("banners")
  @@schema("system")
}

/* Thông báo trong-app cho user (khách lẫn nhân viên) — NotificationGateway ghi trong tx của module nghiệp vụ. */
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(200)
  content   String?   @db.VarChar(1000)
  link      String?   @db.VarChar(500)
  payload   Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
  @@schema("system")
}

model ContactMessage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(120)
  email     String    @db.VarChar(255)
  phone     String?   @db.VarChar(20)
  message   String    @db.VarChar(2000)
  status    String    @default("new") @db.VarChar(20)
  reply     String?   @db.VarChar(2000)
  handledBy String?   @map("handled_by") @db.Uuid
  handledAt DateTime? @map("handled_at") @db.Timestamptz
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, createdAt(sort: Desc)])
  @@map("contact_messages")
  @@schema("system")
}

model Faq {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question  String   @db.VarChar(300)
  answer    String
  groupCode String   @default("general") @map("group_code") @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@map("faqs")
  @@schema("system")
}

/* Trang tĩnh: about · shipping · returns-policy · privacy · terms (markdown). */
model Page {
  slug      String   @id @db.VarChar(60)
  title     String   @db.VarChar(200)
  content   String
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("pages")
  @@schema("system")
}

model SystemAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorEmail     String?  @map("actor_email") @db.VarChar(255)
  action         String   @db.VarChar(80)
  moduleCode     String   @map("module_code") @db.VarChar(40)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  entityCode     String?  @map("entity_code") @db.VarChar(100)
  requestId      String?  @map("request_id") @db.VarChar(64)
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(128)
  beforeSummary  Json?    @map("before_summary")
  afterSummary   Json?    @map("after_summary")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("system")
}
