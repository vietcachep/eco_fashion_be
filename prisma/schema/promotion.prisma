// =====================================================================
// Module promotion (PLAN-0008) — schema "promotion": mã giảm giá (%, số tiền, freeship), điều kiện, hạn mức, lượt dùng.
// Lượt dùng: consume trong tx của order (khoá dòng promotions), release khi huỷ đơn. Tiền numeric(14,0).
// =====================================================================

model Promotion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String   @db.VarChar(40)
  name              String   @db.VarChar(200)
  description       String?  @db.VarChar(500)
  /**
   * percentage | fixed_amount | free_shipping
   */
  type              String   @db.VarChar(20)
  /**
   * % (0–100) hoặc số tiền VND; free_shipping = 0
   */
  value             Decimal  @default(0) @db.Decimal(14, 2)
  maxDiscount       Decimal? @map("max_discount") @db.Decimal(14, 0)
  minOrderAmount    Decimal  @default(0) @map("min_order_amount") @db.Decimal(14, 0)
  usageLimit        Int?     @map("usage_limit")
  usageLimitPerUser Int?     @map("usage_limit_per_user")
  usedCount         Int      @default(0) @map("used_count")
  /**
   * all | category | product — target ở promotion_targets
   */
  appliesTo         String   @default("all") @map("applies_to") @db.VarChar(20)
  startsAt          DateTime @map("starts_at") @db.Timestamptz
  endsAt            DateTime @map("ends_at") @db.Timestamptz
  isActive          Boolean  @default(true) @map("is_active")
  /**
   * Hiện trên web (phiếu voucher) hay chỉ nhập tay.
   */
  isPublic          Boolean  @default(true) @map("is_public")
  /**
   * platform = voucher SÀN (áp trên tổng OrderGroup) | shop = voucher GIAN HÀNG (chỉ áp cho đơn con của đúng
   * `shopId`) — PLAN-0017. CHECK ở migration: platform ⇒ shop_id NULL, shop ⇒ shop_id NOT NULL.
   */
  scope             String   @default("platform") @db.VarChar(10)
  shopId            String?  @map("shop_id") @db.Uuid
  version           Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String?  @map("created_by") @db.Uuid
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy         String?  @map("updated_by") @db.Uuid
  isDeleted         Boolean  @default(false) @map("is_deleted")

  targets PromotionTarget[]
  usages  PromotionUsage[]

  @@index([isActive, startsAt, endsAt])
  @@index([scope, shopId])
  @@map("promotions")
  @@schema("promotion")
}

model PromotionTarget {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId String @map("promotion_id") @db.Uuid
  /**
   * category | product
   */
  targetType  String @map("target_type") @db.VarChar(20)
  /**
   * slug ngành hàng hoặc id sản phẩm (không FK xuyên schema)
   */
  targetRef   String @map("target_ref") @db.VarChar(160)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, targetType, targetRef])
  @@map("promotion_targets")
  @@schema("promotion")
}

model PromotionUsage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId    String    @map("promotion_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  orderCode      String    @map("order_code") @db.VarChar(30)
  discountAmount Decimal   @map("discount_amount") @db.Decimal(14, 0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /**
   * Huỷ đơn → nhả lượt (giữ dòng để truy vết)
   */
  releasedAt     DateTime? @map("released_at") @db.Timestamptz

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, orderCode])
  @@index([userId, promotionId])
  @@map("promotion_usages")
  @@schema("promotion")
}

model PromotionAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorEmail     String?  @map("actor_email") @db.VarChar(255)
  action         String   @db.VarChar(80)
  moduleCode     String   @map("module_code") @db.VarChar(40)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  entityCode     String?  @map("entity_code") @db.VarChar(100)
  requestId      String?  @map("request_id") @db.VarChar(64)
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(128)
  beforeSummary  Json?    @map("before_summary")
  afterSummary   Json?    @map("after_summary")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("promotion")
}
