// =====================================================================
// Module promotion (PLAN-0008) — schema "promotion": mã giảm giá (%, số tiền, freeship), điều kiện, hạn mức, lượt dùng.
// Lượt dùng: consume trong tx của order (khoá dòng promotions), release khi huỷ đơn. Tiền numeric(14,0).
// =====================================================================

model Promotion {
  liveCampaignId String? @unique @map("live_campaign_id") @db.Uuid
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String   @db.VarChar(40)
  name              String   @db.VarChar(200)
  description       String?  @db.VarChar(500)
  /**
   * percentage | fixed_amount | free_shipping
   */
  type              String   @db.VarChar(20)
  /**
   * % (0–100) hoặc số tiền VND; free_shipping = 0
   */
  value             Decimal  @default(0) @db.Decimal(14, 2)
  maxDiscount       Decimal? @map("max_discount") @db.Decimal(14, 0)
  minOrderAmount    Decimal  @default(0) @map("min_order_amount") @db.Decimal(14, 0)
  usageLimit        Int?     @map("usage_limit")
  usageLimitPerUser Int?     @map("usage_limit_per_user")
  usedCount         Int      @default(0) @map("used_count")
  /**
   * all | category | product — target ở promotion_targets
   */
  appliesTo         String   @default("all") @map("applies_to") @db.VarChar(20)
  startsAt          DateTime @map("starts_at") @db.Timestamptz
  endsAt            DateTime @map("ends_at") @db.Timestamptz
  isActive          Boolean  @default(true) @map("is_active")
  /**
   * Hiện trên web (phiếu voucher) hay chỉ nhập tay.
   */
  isPublic          Boolean  @default(true) @map("is_public")
  /**
   * platform = voucher SÀN (áp trên tổng OrderGroup) | shop = voucher GIAN HÀNG (chỉ áp cho đơn con của đúng
   * `shopId`) — PLAN-0017. CHECK ở migration: platform ⇒ shop_id NULL, shop ⇒ shop_id NOT NULL.
   */
  scope             String   @default("platform") @db.VarChar(10)
  shopId            String?  @map("shop_id") @db.Uuid
  version           Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String?  @map("created_by") @db.Uuid
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy         String?  @map("updated_by") @db.Uuid
  isDeleted         Boolean  @default(false) @map("is_deleted")

  targets PromotionTarget[]
  usages  PromotionUsage[]

  @@index([isActive, startsAt, endsAt])
  @@index([scope, shopId])
  @@map("promotions")
  @@schema("promotion")
}

model LiveVoucherCampaign {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  shopId String @map("shop_id") @db.Uuid
  promotionId String @unique @map("promotion_id") @db.Uuid
  state String @default("draft") @db.VarChar(20)
  claimLimit Int @default(100) @map("claim_limit")
  claimedCount Int @default(0) @map("claimed_count")
  redeemUntil DateTime? @map("redeem_until") @db.Timestamptz
  policyVersion String @default("FITLY_LIVE_V1") @map("policy_version") @db.VarChar(40)
  reason String? @db.VarChar(500)
  version Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  isDeleted Boolean @default(false) @map("is_deleted")
  @@index([sessionId, state])
  @@map("live_campaigns")
  @@schema("promotion")
}

/// Receipt quyền kỹ thuật campaign-user; actor=userId, không soft-delete để tránh nhận lại sau khi đã dùng.
model LiveVoucherClaim {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String @map("campaign_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  state String @default("available") @db.VarChar(30)
  activeUseId String? @map("active_use_id") @db.Uuid
  recoveryEntitlementId String? @unique @map("recovery_entitlement_id") @db.Uuid
  recoveryLines Json? @map("recovery_lines")
  restoreReason String? @map("restore_reason") @db.VarChar(255)
  version Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  @@unique([campaignId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("live_claims")
  @@schema("promotion")
}

/// Lịch sử liên kết claim-usage/order và đối soát phục hồi; không soft-delete hay ghi đè snapshot covered.
model LiveVoucherUse {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claimId String @map("claim_id") @db.Uuid
  campaignId String @map("campaign_id") @db.Uuid
  promotionUsageId String @unique @map("promotion_usage_id") @db.Uuid
  orderCode String @map("order_code") @db.VarChar(30)
  covered Json
  discount Decimal @db.Decimal(14, 0)
  policyVersion String @default("FITLY_LIVE_V1") @map("policy_version") @db.VarChar(40)
  state String @default("active") @db.VarChar(30)
  restoredAt DateTime? @map("restored_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([state, createdAt])
  @@map("live_uses")
  @@schema("promotion")
}

/// Nhật ký policy append-only; miễn cột master/version/soft-delete, giữ actor và thời điểm thực hiện.
model LivePromotionAudit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  action String @db.VarChar(80)
  entityId String @map("entity_id") @db.Uuid
  summary Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([entityId, createdAt])
  @@map("live_audit_logs")
  @@schema("promotion")
}

model PromotionTarget {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId String @map("promotion_id") @db.Uuid
  /**
   * category | product
   */
  targetType  String @map("target_type") @db.VarChar(20)
  /**
   * slug ngành hàng hoặc id sản phẩm (không FK xuyên schema)
   */
  targetRef   String @map("target_ref") @db.VarChar(160)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, targetType, targetRef])
  @@map("promotion_targets")
  @@schema("promotion")
}

model PromotionUsage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId    String    @map("promotion_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  orderCode      String    @map("order_code") @db.VarChar(30)
  discountAmount Decimal   @map("discount_amount") @db.Decimal(14, 0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /**
   * Huỷ đơn → nhả lượt (giữ dòng để truy vết)
   */
  releasedAt     DateTime? @map("released_at") @db.Timestamptz

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, orderCode])
  @@index([userId, promotionId])
  @@map("promotion_usages")
  @@schema("promotion")
}

model PromotionAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorEmail     String?  @map("actor_email") @db.VarChar(255)
  action         String   @db.VarChar(80)
  moduleCode     String   @map("module_code") @db.VarChar(40)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  entityCode     String?  @map("entity_code") @db.VarChar(100)
  requestId      String?  @map("request_id") @db.VarChar(64)
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(128)
  beforeSummary  Json?    @map("before_summary")
  afterSummary   Json?    @map("after_summary")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("promotion")
}
