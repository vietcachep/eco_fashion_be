// =====================================================================
// Module cart (PLAN-0005) — schema "cart": giỏ hàng theo user (khoá dòng = biến thể) + yêu thích.
// Không lưu giá/tên snapshot trong giỏ: đọc sống qua ProductQueryApi (giá đổi là giỏ đổi); snapshot chỉ chốt khi tạo đơn.
// =====================================================================

model Cart {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  items CartItem[]

  @@map("carts")
  @@schema("cart")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid // PLAN-0014 bước 6: denormalize từ Product lúc thêm giỏ
  quantity  Int
  /**
   * Dòng được tick để thanh toán (FE cho chọn từng dòng).
   */
  selected  Boolean  @default(true)
  sourceLots Json @default("[]") @map("source_lots")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@index([shopId])
  @@map("cart_items")
  @@schema("cart")
}

/// Receipt kỹ thuật chống dùng lại source grant; bất biến, actor=userId, không soft-delete hay sửa lịch sử.
model CartSourceReceipt {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  referenceId String @map("reference_id") @db.Uuid
  kind String @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([userId, createdAt])
  @@map("source_receipts")
  @@schema("cart")
}

/// Khoá idempotency kỹ thuật của mutation giỏ; giữ hash/requestId, không phải master data cần soft-delete.
model CartMutation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  requestId String @map("request_id") @db.VarChar(100)
  requestHash String @map("request_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@unique([userId, requestId])
  @@map("mutations")
  @@schema("cart")
}

model Wishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, productId])
  @@map("wishlists")
  @@schema("cart")
}
