// =====================================================================
// identity — user (khách + nhân viên), vai, quyền, override, refresh token, lịch sử đăng nhập, địa chỉ,
// audit/outbox/processed-event của module. PLAN-0002.
// Cột chuẩn (AGENTS.md — Base Entity Rule): id, version, created_at/by, updated_at/by, is_deleted.
// Unique theo PARTIAL INDEX (WHERE is_deleted = false) viết tay trong migration SQL — Prisma không tả được;
// ở đây chỉ khai @@index để Prisma biết cột, còn UNIQUE thật nằm trong migration.
// =====================================================================

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(true) @map("is_system")
  /**
   * platform | shop — vai áp dụng toàn hệ thống (nhân viên sàn) hay chỉ trong phạm vi MỘT gian hàng (PLAN-0014).
   * Vai scope=shop KHÔNG BAO GIỜ gán vào User.roleId — chỉ dùng qua ShopMember.roleId (module shop, đọc qua
   * identity.queryapi), nên preset quyền của vai đó tách biệt hoàn toàn khỏi quyền toàn cục của user.
   */
  scope       String   @default("platform") @map("scope") @db.VarChar(20)
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy   String?  @map("updated_by") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
  @@schema("identity")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(100)
  moduleCode  String   @map("module_code") @db.VarChar(40)
  description String   @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy   String?  @map("updated_by") @db.Uuid
  isDeleted   Boolean  @default(false) @map("is_deleted")

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([moduleCode])
  @@map("permissions")
  @@schema("identity")
}

/// Quan hệ vai ↔ quyền: hàng chỉ có/không có, không có "sửa" → không cần cột chuẩn.
model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

/// Khách lẫn nhân viên cùng bảng, phân biệt bằng vai. `permission_version` tăng khi đổi vai/quyền/khoá →
/// access token cũ (claim pv) bị từ chối ngay. Không bao giờ trả password_hash ra DTO.
model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @db.VarChar(255)
  phone             String?   @db.VarChar(20)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  fullName          String    @map("full_name") @db.VarChar(120)
  avatarUrl         String?   @map("avatar_url") @db.VarChar(500)
  roleId            String    @map("role_id") @db.Uuid
  status            String    @default("active") @db.VarChar(30)
  permissionVersion Int       @default(1) @map("permission_version")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  lockedReason      String?   @map("locked_reason") @db.VarChar(255)
  /**
   * Đăng nhập Google: `sub` của Google id_token (unique); user Google có password_hash ngẫu nhiên không dùng được.
   */
  googleSub         String?   @unique @map("google_sub") @db.VarChar(64)
  version           Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy         String?   @map("updated_by") @db.Uuid
  isDeleted         Boolean   @default(false) @map("is_deleted")

  role            Role             @relation(fields: [roleId], references: [id])
  userPermissions UserPermission[]
  refreshTokens   RefreshToken[]
  addresses       Address[]

  @@index([roleId])
  @@index([status])
  @@index([email])
  @@map("users")
  @@schema("identity")
}

/// Ngoại lệ quyền theo từng người: allowed=true cấp thêm, false chặn — DENY THẮNG khi tính quyền hiệu lực.
model UserPermission {
  userId       String   @map("user_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  allowed      Boolean
  reason       String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?  @map("created_by") @db.Uuid
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy    String?  @map("updated_by") @db.Uuid

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
  @@schema("identity")
}

/// Chỉ lưu HASH SHA-256 của refresh token; family_id gom mọi token của một lần đăng nhập để thu hồi cả họ
/// khi phát hiện dùng lại token đã rotate. Append-only, thu hồi bằng revoked_at.
model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  familyId      String    @map("family_id") @db.Uuid
  deviceName    String?   @map("device_name") @db.VarChar(120)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  revokedReason String?   @map("revoked_reason") @db.VarChar(40)
  replacedById  String?   @map("replaced_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
  @@schema("identity")
}

/// Lịch sử đăng nhập (thành công + thất bại) — job dọn theo EF_LOGIN_HISTORY_RETENTION_DAYS.
model LoginHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String   @db.VarChar(255)
  success   Boolean
  reason    String?  @db.VarChar(40)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("login_histories")
  @@schema("identity")
}

/// Sổ địa chỉ giao hàng (VN). Một địa chỉ mặc định/user (partial unique trong migration). Đơn CHÉP snapshot, không FK.
model Address {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.VarChar(120)
  phone         String   @db.VarChar(20)
  provinceCode  String?  @map("province_code") @db.VarChar(10)
  provinceName  String   @map("province_name") @db.VarChar(100)
  districtName  String?  @map("district_name") @db.VarChar(100)
  wardName      String?  @map("ward_name") @db.VarChar(100)
  street        String   @db.VarChar(255)
  isDefault     Boolean  @default(false) @map("is_default")
  note          String?  @db.VarChar(255)
  version       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy     String?  @map("updated_by") @db.Uuid
  isDeleted     Boolean  @default(false) @map("is_deleted")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
  @@schema("identity")
}

model IdentityAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorEmail     String?  @map("actor_email") @db.VarChar(255)
  action         String   @db.VarChar(80)
  moduleCode     String   @map("module_code") @db.VarChar(40)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  entityCode     String?  @map("entity_code") @db.VarChar(100)
  requestId      String?  @map("request_id") @db.VarChar(64)
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(128)
  beforeSummary  Json?    @map("before_summary")
  afterSummary   Json?    @map("after_summary")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("identity")
}

model IdentityOutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(80)
  eventVersion  String    @default("v1") @map("event_version") @db.VarChar(10)
  aggregateType String    @map("aggregate_type") @db.VarChar(80)
  aggregateId   String    @map("aggregate_id") @db.VarChar(64)
  payload       Json
  status        String    @default("PENDING") @db.VarChar(20)
  retryCount    Int       @default(0) @map("retry_count")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  errorMessage  String?   @map("error_message")
  requestId     String?   @map("request_id") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  processedAt   DateTime? @map("processed_at") @db.Timestamptz

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
  @@schema("identity")
}

model IdentityProcessedEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(80)
  handler     String   @db.VarChar(120)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@unique([eventId, handler])
  @@map("processed_events")
  @@schema("identity")
}
