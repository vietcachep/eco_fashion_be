// =====================================================================
// Module review (PLAN-0009) — schema "review": đánh giá của khách ĐÃ MUA (gắn dòng đơn), ảnh/video minh chứng,
// trả lời của shop, kiểm duyệt. Điểm trung bình ghi sang product qua ProductStatsGateway (đếm sẵn).
// =====================================================================

model Review {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  productSlug    String    @map("product_slug") @db.VarChar(160)
  productName    String    @map("product_name") @db.VarChar(200)
  shopId         String    @map("shop_id") @db.Uuid                      // PLAN-0014 bước 9: snapshot shopId cho review.reply của vendor
  userId         String    @map("user_id") @db.Uuid
  authorName     String    @map("author_name") @db.VarChar(120)
  avatarUrl      String?   @map("avatar_url") @db.VarChar(500)
  /* Đánh giá từ đơn: biết màu/size; từ trang sản phẩm (đã mua trước đó): null */
  orderCode      String?   @map("order_code") @db.VarChar(30)
  orderItemId    String?   @map("order_item_id") @db.Uuid
  variantLabel   String?   @map("variant_label") @db.VarChar(160)
  rating         Int
  content        String    @db.VarChar(2000)
  /* MediaItem[] {type,url,name} */
  media          Json      @default("[]")
  /* pending | approved | hidden — kiểm duyệt; mặc định approved, AI/nhân viên có thể ẩn */
  status         String    @default("approved") @db.VarChar(20)
  moderationNote String?   @map("moderation_note") @db.VarChar(500)
  moderatedBy    String?   @map("moderated_by") @db.Uuid
  moderatedAt    DateTime? @map("moderated_at") @db.Timestamptz
  helpfulCount   Int       @default(0) @map("helpful_count")
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  isDeleted      Boolean   @default(false) @map("is_deleted")

  replies ReviewReply[]

  @@unique([userId, orderItemId])
  @@index([productId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([shopId])                                                      // PLAN-0014: lọc review theo shop
  @@map("reviews")
  @@schema("review")
}

model ReviewReply {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId    String   @map("review_id") @db.Uuid
  staffUserId String   @map("staff_user_id") @db.Uuid
  /// Tên lúc ghi (shop: tên gian hàng; platform: 'Sàn FITLY'). Dữ liệu CŨ có thể còn HỌ TÊN nhân viên ⇒ API công khai KHÔNG đọc cột này, tính tên từ author_kind.
  staffName   String   @map("staff_name") @db.VarChar(120)
  /// shop | platform (CHECK ck_review_replies_author_kind): ai đứng tên phản hồi — gian hàng (vendor) hay sàn (nhân viên sàn). Quyết định tên hiển thị công khai.
  authorKind  String   @default("platform") @map("author_kind") @db.VarChar(20)
  content     String   @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_replies")
  @@schema("review")
}

model ReviewAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorEmail     String?  @map("actor_email") @db.VarChar(255)
  action         String   @db.VarChar(80)
  moduleCode     String   @map("module_code") @db.VarChar(40)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  entityCode     String?  @map("entity_code") @db.VarChar(100)
  requestId      String?  @map("request_id") @db.VarChar(64)
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(128)
  beforeSummary  Json?    @map("before_summary")
  afterSummary   Json?    @map("after_summary")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("review")
}

model ReviewOutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(80)
  eventVersion  String    @default("v1") @map("event_version") @db.VarChar(10)
  aggregateType String    @map("aggregate_type") @db.VarChar(80)
  aggregateId   String    @map("aggregate_id") @db.VarChar(64)
  payload       Json
  status        String    @default("PENDING") @db.VarChar(20)
  retryCount    Int       @default(0) @map("retry_count")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  errorMessage  String?   @map("error_message")
  requestId     String?   @map("request_id") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  processedAt   DateTime? @map("processed_at") @db.Timestamptz

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
  @@schema("review")
}

model ReviewProcessedEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(80)
  handler     String   @db.VarChar(120)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@unique([eventId, handler])
  @@map("processed_events")
  @@schema("review")
}
