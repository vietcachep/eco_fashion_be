// =====================================================================
// Module payment (PLAN-0007/0018) — schema "payment": phương thức (chỉ còn cod · payos; dòng vnpay/bank_transfer cũ đã tắt),
// giao dịch theo đơn, nhật ký gọi cổng (webhook idempotent theo provider_ref), hoàn tiền, đối soát chi trả shop.
// KHÔNG BAO GIỜ lưu số thẻ / CVV / OTP. Cột cardBrand/cardLast4/transferContent/bank_transfer_confirmations là DỮ LIỆU LỊCH SỬ (VNPay/VietQR cũ).
// =====================================================================

model PaymentMethod {
  code        String   @id @db.VarChar(20)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(300)
  /**
   * cod | gateway (lịch sử còn bank_transfer)
   */
  kind        String   @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  /**
   * Cấu hình hiển thị công khai (tên ngân hàng, hướng dẫn…) — không chứa secret
   */
  config      Json?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy   String?  @map("updated_by") @db.Uuid

  @@map("payment_methods")
  @@schema("payment")
}

model Payment {
  collectionMode String? @map("collection_mode") @db.VarChar(30)
  codCollectedAt DateTime? @map("cod_collected_at") @db.Timestamptz
  codRemittedAt DateTime? @map("cod_remitted_at") @db.Timestamptz
  codRemittedBy String? @map("cod_remitted_by") @db.Uuid
  codRemittanceRef String? @unique @map("cod_remittance_ref") @db.VarChar(100)
  codRemittedAmount Decimal? @map("cod_remitted_amount") @db.Decimal(14,0)
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  orderCode       String    @map("order_code") @db.VarChar(30)
  /**
   * Gian hàng của đơn con (đơn nào thuộc đúng 1 shop) — để sàn lọc giao dịch theo shop; null ở dữ liệu cũ chưa gắn được
   */
  shopId          String?   @map("shop_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  methodCode      String    @map("method_code") @db.VarChar(20)
  amount          Decimal   @db.Decimal(14, 0)
  /**
   * pending | processing | paid | failed | expired | refunded | partially_refunded
   */
  status          String    @default("pending") @db.VarChar(20)
  /**
   * Mã giao dịch phía cổng (orderCode PayOS) / mã tham chiếu ngân hàng (lịch sử)
   */
  transactionCode String?   @map("transaction_code") @db.VarChar(64)
  bankCode        String?   @map("bank_code") @db.VarChar(20)
  cardBrand       String?   @map("card_brand") @db.VarChar(20)
  cardLast4       String?   @map("card_last4") @db.VarChar(4)
  /**
   * Lịch sử (VietQR cũ): nội dung CK để đối soát (= mã đơn) — không còn ghi mới
   */
  transferContent String?   @map("transfer_content") @db.VarChar(60)
  refundedAmount  Decimal   @default(0) @map("refunded_amount") @db.Decimal(14, 0)
  /**
   * Tiền khách THỰC TRẢ (cộng dồn các giao dịch PayOS đã nhận) — có thể lệch `amount` (thiếu/thừa/trùng). Backfill = amount cho payment đã thu
   */
  receivedAmount  Decimal   @default(0) @map("received_amount") @db.Decimal(14, 0)
  /**
   * Số lần tạo link PayOS + lỗi lần gần nhất (link được tạo SAU commit đặt hàng; lỗi ⇒ payment vẫn pending, khách thử lại)
   */
  linkAttempts    Int       @default(0) @map("link_attempts")
  lastLinkError   String?   @map("last_link_error") @db.VarChar(255)
  /**
   * Lần hỏi PayOS gần nhất + trạng thái PayOS trả về (job payos-reconcile-pending)
   */
  lastCheckedAt     DateTime? @map("last_checked_at") @db.Timestamptz
  lastGatewayStatus String?   @map("last_gateway_status") @db.VarChar(30)
  /**
   * PLAN-0040 Tầng 3.6 (COD-08b) — lúc ĐẢO ghi thu COD: shop đã báo giao (payment `paid`) nhưng khách báo CHƯA NHẬN hàng ⇒ khách chưa từng trả tiền mặt ⇒ payment về `cancelled` kèm mốc này
   * (không phải hoàn tiền; ví shop được trả lại hoa hồng/phần voucher sàn đã ghi). NULL = chưa từng bị đảo. Chỉ payment COD.
   */
  reversedAt        DateTime? @map("reversed_at") @db.Timestamptz
  gatewayResponse Json?     @map("gateway_response")
  paidAt          DateTime? @map("paid_at") @db.Timestamptz
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy       String?   @map("updated_by") @db.Uuid

  transactions  PaymentTransaction[]
  confirmations BankTransferConfirmation[]
  refunds       Refund[]

  @@index([orderId])
  @@index([shopId, createdAt(sort: Desc)])
  @@index([orderCode])
  @@index([status, expiresAt])
  @@map("payments")
  @@schema("payment")
}

/**
 * Mỗi lần gọi/nhận từ cổng một dòng — IPN trùng (provider_ref) bị unique chặn → không cộng tiền 2 lần.
 */
model PaymentTransaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  /**
   * create_url | ipn | return | query | refund | manual_confirm
   */
  type        String   @db.VarChar(20)
  status      String   @db.VarChar(20)
  amount      Decimal? @db.Decimal(14, 0)
  providerRef String?  @map("provider_ref") @db.VarChar(120)
  rawRequest  Json?    @map("raw_request")
  rawResponse Json?    @map("raw_response")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_transactions")
  @@schema("payment")
}

/// BẢNG LỊCH SỬ (PLAN-0018): chuyển khoản VietQR đối soát tay đã bị bỏ — chỉ giữ dữ liệu cũ, code không còn ghi bảng này.
model BankTransferConfirmation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  amount      Decimal  @db.Decimal(14, 0)
  bankRef     String?  @map("bank_ref") @db.VarChar(120)
  note        String?  @db.VarChar(500)
  confirmedBy String   @map("confirmed_by") @db.Uuid
  confirmedAt DateTime @default(now()) @map("confirmed_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("bank_transfer_confirmations")
  @@schema("payment")
}

/**
 * Hoàn tiền: requested → processing → done | failed. Cổng (PayOS payout) hoặc chuyển khoản tay (COD/dữ liệu lịch sử).
 */
model Refund {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId          String    @map("payment_id") @db.Uuid
  orderCode          String    @map("order_code") @db.VarChar(30)
  returnRequestId    String?   @map("return_request_id") @db.Uuid
  amount             Decimal   @db.Decimal(14, 0)
  status             String    @default("requested") @db.VarChar(20)
  /**
   * gateway | manual_transfer
   */
  method             String    @db.VarChar(20)
  providerRef        String?   @map("provider_ref") @db.VarChar(120)
  reason             String?   @db.VarChar(255)
  note               String?   @db.VarChar(500)
  requestedBy        String?   @map("requested_by") @db.Uuid
  processedBy        String?   @map("processed_by") @db.Uuid
  processedAt        DateTime? @map("processed_at") @db.Timestamptz
  /**
   * PLAN-0017 — snapshot gian hàng của đơn bị hoàn (đối soát payout trừ hoàn tiền đúng shop). Đơn cũ = NULL.
   */
  shopId             String?   @map("shop_id") @db.Uuid
  /**
   * order = hoàn theo đơn (huỷ / đổi trả / thanh toán đến muộn) · duplicate_payment = hoàn khoản khách trả TRÙNG cho đơn đã có khoản khác thu xong:
   * chỉ trả tiền thừa cho khách, KHÔNG đổi trạng thái thanh toán của đơn, không đảo doanh thu/hoa hồng. CHECK chk_refunds_kind.
   */
  kind               String    @default("order") @db.VarChar(20)
  /**
   * Dấu "đã/đang gọi cổng" ghi TRƯỚC khi gọi cổng KHÔNG có idempotency-key (VNPay cũ — chỉ còn dữ liệu lịch sử). Còn dấu mà chưa có provider_ref ⇒ chưa rõ cổng đã hoàn hay chưa
   * (treo/mất kết nối) ⇒ KHÔNG được tự gọi lại cổng, phải đối chiếu tay. Cổng báo từ chối rõ ràng thì xoá dấu (tiền chưa đi).
   */
  gatewayAttemptedAt DateTime? @map("gateway_attempted_at") @db.Timestamptz
  /**
   * PLAN-0022 — tài khoản ngân hàng NHẬN tiền hoàn do KHÁCH khai (bắt buộc với đơn COD; PayOS thì dùng tài khoản đã trả nếu có). Số đầy đủ chỉ dùng khi gọi PayOS payout,
   * API chỉ trả 4 số cuối. `payee_bin` = BIN 6 số Napas (cùng dạng `toBin` của payout). Dữ liệu cũ = NULL.
   */
  payeeBankBin       String?   @map("payee_bank_bin") @db.VarChar(10)
  payeeAccountNumber String?   @map("payee_account_number") @db.VarChar(34)
  payeeAccountName   String?   @map("payee_account_name") @db.VarChar(120)
  /**
   * Nguồn tài khoản đã/đang dùng để chi: customer (khách khai) | payer (tài khoản đã trả tiền — counterAccount* trong webhook PayOS). Ghi khi tạo yêu cầu (customer) và khi gửi lệnh chi.
   */
  payeeSource        String?   @map("payee_source") @db.VarChar(12)
  /**
   * PLAN-0022 — trạng thái lệnh chi PayOS: submitted (PayOS đã NHẬN lệnh, chưa chốt) | processing (đã tra, còn đang xử lý) | succeeded | failed (PayOS báo lỗi/huỷ/hoàn).
   * PayOS trả code "00" chỉ là đã nhận lệnh — refund chỉ `done` khi poll `getPayout` ra succeeded. NULL = chưa gửi lệnh nào / hoàn tay.
   */
  gatewayStatus      String?   @map("gateway_status") @db.VarChar(16)
  /**
   * Mã lệnh chi PayOS (`data.id` của /v1/payouts) — dùng tra `getPayout`; KHÔNG phải provider_ref (provider_ref chỉ ghi khi PayOS xác nhận đã chuyển).
   */
  gatewayPayoutId    String?   @map("gateway_payout_id") @db.VarChar(64)
  /**
   * Số lần ĐÃ tạo lệnh chi mới trên PayOS cho refund này (0 = chưa). Lệnh đầu dùng referenceId/idempotency-key = refund.id; chỉ khi lệnh trước bị PayOS báo thất bại hẳn
   * mới tạo lệnh mới với hậu tố `-<lần>` (không bao giờ gửi lại cùng lệnh khi chưa rõ kết quả).
   */
  gatewayAttempt     Int       @default(0) @map("gateway_attempt")
  /**
   * Lúc PayOS nhận lệnh chi; NOT NULL khi refund `processing` ⇒ job đối soát `reconcileGatewayRefunds` tra kết quả, KHÔNG nhả/chi lại. Xoá khi chiếm lại để chi lệnh mới.
   */
  gatewaySubmittedAt DateTime? @map("gateway_submitted_at") @db.Timestamptz
  /**
   * Đã báo kế toán "PayOS treo bất thường" (processing quá REFUND_GATEWAY_STALL_MS chưa chốt, hoặc PayOS nhận lệnh nhưng không trả mã tra cứu) — chỉ báo MỘT lần (compare-and-set).
   */
  gatewayAlertedAt   DateTime? @map("gateway_alerted_at") @db.Timestamptz
  /**
   * Khoản hoàn cần kế toán xử lý tay: không có đường tự chi (thiếu tài khoản nhận / không qua PayOS) hoặc PayOS treo bất thường. Cột phi chuẩn hoá để lọc danh sách; API còn cộng điều kiện
   * "chưa cấu hình khoá payout" lúc đọc.
   */
  needsManual        Boolean   @default(false) @map("needs_manual")
  version            Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // provider_ref (mã giao dịch hoàn tay / `payos-refund:<payoutId>`) DUY NHẤT khi khác NULL — unique index MỘT PHẦN `uq_refunds_provider_ref` viết tay trong migration
  // 20261026100100_return_roles_payment (Prisma không biểu diễn được). Trùng ⇒ P2002 ⇒ 409 REFUND_PROVIDER_REF_DUPLICATE.
  @@index([status, createdAt(sort: Desc)])
  @@index([shopId])
  @@index([orderCode])
  @@index([paymentId])
  @@index([returnRequestId])
  @@map("refunds")
  @@schema("payment")
}

/**
 * ===================== PLAN-0017/0018 — đối soát (payout) theo gian hàng; PLAN-0018 bỏ ví quỹ COD =====================
 */

/**
 * Kỳ đối soát (payout) một shop: số liệu ĐÓNG BĂNG lúc chạy kỳ. netPayout = gross − commission − refund − carriedDebt,
 * CÓ THỂ ÂM (khi đó không chi, âm sang kỳ sau qua carriedDebt). status: pending | processing | paid | failed (chi được) |
 * carried (net < 0 — không chi, mang nợ) | settled (net = 0 — không có gì để chi) — một chiều (không có đường paid → pending).
 * Mỗi (shopId, periodStart, periodEnd) một dòng.
 */
model ShopPayout {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String    @unique @db.VarChar(30)
  shopId             String    @map("shop_id") @db.Uuid
  periodStart        DateTime  @map("period_start") @db.Timestamptz
  periodEnd          DateTime  @map("period_end") @db.Timestamptz
  grossRevenue       Decimal   @map("gross_revenue") @db.Decimal(14, 0)
  commission         Decimal   @db.Decimal(14, 0)
  refundAmount       Decimal   @map("refund_amount") @db.Decimal(14, 0)
  carriedDebt        Decimal   @default(0) @map("carried_debt") @db.Decimal(14, 0)
  netPayout          Decimal   @map("net_payout") @db.Decimal(14, 0)
  status             String    @default("pending") @db.VarChar(20)
  /**
   * Mã giao dịch chi PayOS / mã chuyển khoản tay — chống chi trùng + tra soát
   */
  providerRef        String?   @map("provider_ref") @db.VarChar(120)
  failReason         String?   @map("fail_reason") @db.VarChar(500)
  /**
   * Snapshot tài khoản nhận lúc chạy kỳ (đổi hồ sơ shop sau đó không làm lệch chứng từ)
   */
  bankSnapshot       Json?     @map("bank_snapshot")
  paidAt             DateTime? @map("paid_at") @db.Timestamptz
  /**
   * PLAN-0026: kết quả cổng — failed = PayOS TỪ CHỐI chắc chắn (được gửi lại bằng khoá mới); unknown = timeout/5xx/không rõ (KHÔNG được chi lại, KHÔNG được đánh dấu tay khi chưa tra PayOS)
   */
  gatewayStatus      String?   @map("gateway_status") @db.VarChar(16)
  gatewayAttemptedAt DateTime? @map("gateway_attempted_at") @db.Timestamptz
  /**
   * Lần gửi lệnh chi: 1 = khoá `<mã kỳ>`, n>1 = `<mã kỳ>-<n>` (chỉ tăng sau khi PayOS TỪ CHỐI chắc chắn)
   */
  gatewayAttempt     Int       @default(1) @map("gateway_attempt")
  approvedBy         String?   @map("approved_by") @db.Uuid
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz
  holdReason         String?   @map("hold_reason") @db.VarChar(255)
  createdBy          String?   @map("created_by") @db.Uuid
  version            Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  lines ShopPayoutLine[]

  @@unique([shopId, periodStart, periodEnd])
  @@index([status, createdAt(sort: Desc)])
  @@map("shop_payouts")
  @@schema("payment")
}

/**
 * Lệnh GIỮ TAY tiền chi trả của một shop (kế toán/quản lý, có lý do). Mỗi shop tối đa MỘT lệnh đang hiệu lực (released_at NULL — unique một phần uq_shop_payout_holds_active).
 * Kỳ tạo cho shop đang bị giữ ⇒ held; mở giữ (released_at) ⇒ kỳ held về pending.
 */
model ShopPayoutHold {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  reason     String    @db.VarChar(255)
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  releasedBy String?   @map("released_by") @db.Uuid
  releasedAt DateTime? @map("released_at") @db.Timestamptz

  @@index([shopId, createdAt(sort: Desc)])
  @@map("shop_payout_holds")
  @@schema("payment")
}

/**
 * Dòng chi tiết của kỳ: mỗi đơn online đã tính (sale) hoặc mỗi hoàn tiền đã trừ (refund). (orderCode, kind) UNIQUE toàn
 * bảng ⇒ một đơn/hoàn tiền không bao giờ bị tính vào hai kỳ.
 */
model ShopPayoutLine {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payoutId        String  @map("payout_id") @db.Uuid
  /**
   * Khoá duy nhất của dòng: sale = mã đơn · refund = "RF-" + 26 hex đầu của id hoàn tiền (không phải mã đơn — xem source_order_code)
   */
  orderCode       String  @map("order_code") @db.VarChar(30)
  /**
   * sale | refund
   */
  kind            String  @db.VarChar(10)
  gross           Decimal @db.Decimal(14, 0)
  commission      Decimal @db.Decimal(14, 0)
  /**
   * PLAN-0022 — mã ĐƠN thật của dòng hoàn tiền (để shop/kế toán biết khoản trừ này thuộc đơn nào). Dòng sale để NULL (order_code đã là mã đơn).
   * Dòng refund cũ được backfill theo khoá RF-… trong migration 20261026100100_return_roles_payment; không khớp được thì NULL.
   */
  sourceOrderCode String? @map("source_order_code") @db.VarChar(30)

  payout ShopPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@unique([orderCode, kind])
  @@index([payoutId])
  @@map("shop_payout_lines")
  @@schema("payment")
}

/**
 * ===================== PLAN-0020 — ví đặt cọc COD của gian hàng =====================
 */

/**
 * Ví đặt cọc COD: shop chỉ được bán COD khi `balance > 0`. Mỗi đơn COD giao thành công, sàn tự trừ hoa hồng của đơn khỏi ví; về 0 hoặc âm
 * ⇒ khoá COD cho đơn MỚI (đơn đang giao không bị huỷ). Số âm được bù bằng khoản nộp thêm kế tiếp (cộng đại số). Mỗi shop đúng một ví.
 */
model ShopCodWallet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId    String   @unique @map("shop_id") @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(14, 0)
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  transactions ShopCodWalletTransaction[]

  @@map("shop_cod_wallets")
  @@schema("payment")
}

/**
 * Sổ cái ví (chỉ thêm, không sửa): deposit (+) · cod_commission (−hoa hồng đơn COD; âm = cộng lại khi voucher sàn chịu) · cod_refund (hoàn tiền đơn COD)
 * · adjust (sàn chỉnh tay, có lý do) · cod_reversal (PLAN-0040 Tầng 3.6: ĐẢO ghi thu cod_commission khi khách báo chưa nhận hàng — dấu ngược với dòng cod_commission của cùng đơn)
 * · topup_payos (PLAN-0041: nạp cọc qua PayOS, luôn dương, `topup_id`+`ref_key` bắt buộc).
 * (shopId, type, orderCode) UNIQUE với loại theo đơn ⇒ một đơn không bị trừ / đảo hai lần.
 */
model ShopCodWalletTransaction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId     String   @map("wallet_id") @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  type         String   @db.VarChar(20)
  /**
   * Có dấu: + cộng ví, − trừ ví
   */
  amount       Decimal  @db.Decimal(14, 0)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(14, 0)
  orderCode    String?  @map("order_code") @db.VarChar(30)
  depositId    String?  @map("deposit_id") @db.Uuid
  /**
   * PLAN-0041 — khoản nạp PayOS sinh dòng này (chỉ type = topup_payos) + khoá idempotent `payos-topup:<topupId>:<luỹ kế>`; UNIQUE một phần ở SQL (`uq_shop_cod_wallet_tx_ref_key`)
   */
  topupId      String?  @map("topup_id") @db.Uuid
  refKey       String?  @map("ref_key") @db.VarChar(120)
  note         String?  @db.VarChar(500)
  /**
   * Số liệu tính toán (gross, tỉ lệ hoa hồng…) để hoàn đúng phần hoa hồng khi đơn bị hoàn tiền
   */
  meta         Json?
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  wallet ShopCodWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([shopId, type, orderCode])
  @@index([shopId, createdAt(sort: Desc)])
  @@index([topupId])
  @@map("shop_cod_wallet_transactions")
  @@schema("payment")
}

/**
 * Yêu cầu nộp tiền đặt cọc: shop chuyển khoản cho sàn rồi khai số tiền + mã giao dịch; kế toán sàn đối chiếu và duyệt (cộng ví) hoặc từ chối.
 * status: pending | approved | rejected. Mỗi shop tối đa MỘT yêu cầu đang chờ (service kiểm dưới khoá dòng ví).
 */
model ShopCodDeposit {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId       String    @map("shop_id") @db.Uuid
  amount       Decimal   @db.Decimal(14, 0)
  /**
   * Mã giao dịch / nội dung chuyển khoản để kế toán đối chiếu
   */
  transferRef  String    @map("transfer_ref") @db.VarChar(120)
  note         String?   @db.VarChar(500)
  status       String    @default("pending") @db.VarChar(20)
  rejectReason String?   @map("reject_reason") @db.VarChar(500)
  requestedBy  String?   @map("requested_by") @db.Uuid
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([shopId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("shop_cod_deposits")
  @@schema("payment")
}

/**
 * PLAN-0041 — khoản NẠP CỌC QUA PAYOS của gian hàng: chủ shop tạo link PayOS; tiền PayOS xác nhận đã nhận được GHI CÓ vào ví đúng số THỰC NHẬN (xem PLAN-0041 §6).
 * status: creating | pending | partial | paid | expired | cancelled | failed. `received_amount` = tổng đã ghi có cho khoản này = max(Σ biên nhận webhook, polled_amount).
 * Mỗi shop tối đa MỘT khoản mở (creating|pending|partial) — chỉ mục một phần `uq_shop_cod_topups_active_per_shop` (chỉ ở SQL migration). payos_order_code nằm dải 5e15 (CHECK ở SQL).
 * Chứng từ tiền, chỉ thêm/đổi trạng thái, không xoá ⇒ miễn cột `is_deleted` (ghi lý do theo Base Columns Rule).
 */
model ShopCodTopup {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId            String    @map("shop_id") @db.Uuid
  amount            Decimal   @db.Decimal(14, 0)
  payosOrderCode    String    @unique @map("payos_order_code") @db.VarChar(20)
  paymentLinkId     String?   @map("payment_link_id") @db.VarChar(64)
  checkoutUrl       String?   @map("checkout_url") @db.VarChar(500)
  qrCode            String?   @map("qr_code") @db.Text
  status            String    @default("creating") @db.VarChar(20)
  receivedAmount    Decimal   @default(0) @map("received_amount") @db.Decimal(14, 0)
  polledAmount      Decimal   @default(0) @map("polled_amount") @db.Decimal(14, 0)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  paidAt            DateTime? @map("paid_at") @db.Timestamptz
  closedAt          DateTime? @map("closed_at") @db.Timestamptz
  lastCheckedAt     DateTime? @map("last_checked_at") @db.Timestamptz
  lastGatewayStatus String?   @map("last_gateway_status") @db.VarChar(30)
  linkError         String?   @map("link_error") @db.VarChar(255)
  requestedBy       String?   @map("requested_by") @db.Uuid
  cancelledBy       String?   @map("cancelled_by") @db.Uuid
  version           Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  receipts ShopCodTopupReceipt[]

  @@index([shopId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("shop_cod_topups")
  @@schema("payment")
}

/// Mỗi khoản tiền PayOS báo về qua webhook cho một khoản nạp (khử trùng theo `reference`); bảng kỹ thuật chỉ thêm ⇒ miễn cột chuẩn (version/updated/is_deleted).
model ShopCodTopupReceipt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topupId   String   @map("topup_id") @db.Uuid
  reference String   @db.VarChar(120)
  amount    Decimal  @db.Decimal(14, 0)
  raw       Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  topup ShopCodTopup @relation(fields: [topupId], references: [id], onDelete: Cascade)

  @@unique([topupId, reference])
  @@map("shop_cod_topup_receipts")
  @@schema("payment")
}

model PaymentAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorEmail     String?  @map("actor_email") @db.VarChar(255)
  action         String   @db.VarChar(80)
  moduleCode     String   @map("module_code") @db.VarChar(40)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  entityCode     String?  @map("entity_code") @db.VarChar(100)
  requestId      String?  @map("request_id") @db.VarChar(64)
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(128)
  beforeSummary  Json?    @map("before_summary")
  afterSummary   Json?    @map("after_summary")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("payment")
}

model PaymentOutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(80)
  eventVersion  String    @default("v1") @map("event_version") @db.VarChar(10)
  aggregateType String    @map("aggregate_type") @db.VarChar(80)
  aggregateId   String    @map("aggregate_id") @db.VarChar(64)
  payload       Json
  status        String    @default("PENDING") @db.VarChar(20)
  retryCount    Int       @default(0) @map("retry_count")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  errorMessage  String?   @map("error_message")
  requestId     String?   @map("request_id") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  processedAt   DateTime? @map("processed_at") @db.Timestamptz

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
  @@schema("payment")
}

model PaymentProcessedEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(80)
  handler     String   @db.VarChar(120)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@unique([eventId, handler])
  @@map("processed_events")
  @@schema("payment")
}
