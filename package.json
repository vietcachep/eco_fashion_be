{
  "name": "eco-fashion-backend",
  "version": "0.1.0",
  "description": "EcoFashion — backend NestJS cho cửa hàng thời trang (web bán hàng + web quản trị nhiều vai nhân viên)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/src/worker.js",
    "start:worker:dev": "nest start --watch --entryFile src/worker",
    "perms:sync": "ts-node -T -r tsconfig-paths/register scripts/sync-permissions.ts",
    "seed": "ts-node -T -r tsconfig-paths/register scripts/seed/index.ts",
    "seed:admin": "ts-node -T -r tsconfig-paths/register scripts/seed/create-admin.ts",
    "seed:images": "ts-node -T -r tsconfig-paths/register scripts/seed/sync-images.ts",
    "db:dump": "ts-node -T -r tsconfig-paths/register scripts/db/dump.ts",
    "db:secure": "ts-node -T -r tsconfig-paths/register scripts/db/secure-accounts.ts",
    "db:restore": "ts-node -T -r tsconfig-paths/register scripts/db/restore.ts",
    "seed:manifest": "ts-node -T -r tsconfig-paths/register scripts/seed/tools/sync-image-manifest.ts",
    "seed:validate": "ts-node -T -r tsconfig-paths/register scripts/seed/tools/validate-data.ts",
    "seed:gen-images": "ts-node -T -r tsconfig-paths/register scripts/seed/tools/export-image-manifest.ts && python scripts/seed/tools/gen_images.py",
    "lint": "eslint \"{src,scripts,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,scripts,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,scripts,test}/**/*.ts\"",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e.json",
    "verify": "npm run lint && npm run check:boundaries && npm run build && npm test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "migration:dev": "prisma migrate dev",
    "migration:create": "prisma migrate dev --create-only",
    "migration:deploy": "prisma migrate deploy",
    "migration:status": "prisma migrate status",
    "migration:check": "prisma migrate deploy && prisma migrate diff --from-config-datasource --to-schema prisma/schema --exit-code",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.2",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.9.0",
    "nestjs-pino": "^5.2.0",
    "nodemailer": "^10.0.10",
    "openai": "^7.15.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.1",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.3.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
