# =====================================================================
# EcoFashion Backend — file cấu hình mẫu. Copy thành `.env` rồi sửa. KHÔNG commit .env thật.
# Mọi biến có tiền tố EF_. Thiếu biến bắt buộc là app DỪNG lúc khởi động (src/config/env.ts).
# =====================================================================

# --- Ứng dụng ---
EF_APP_NAME=EcoFashion
NODE_ENV=development
EF_PORT=4000
EF_API_PUBLIC_URL=http://localhost:4000
EF_WEB_URL=http://localhost:3000
EF_API_PREFIX=api/v1
EF_SWAGGER_ENABLED=true
# Origin của web bán hàng + web quản trị, phân tách bằng dấu phẩy
EF_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# URL công khai của backend (PayOS gọi webhook về đây; production phải là https)
EF_PUBLIC_URL=http://localhost:4000
# URL web bán hàng (trang kết quả thanh toán, link trong email)
EF_STOREFRONT_URL=http://localhost:3000
EF_LOG_LEVEL=info
# Số proxy tin cậy đứng trước app (0 = chạy trần) — dùng để đọc IP thật từ X-Forwarded-For
EF_TRUSTED_PROXY_COUNT=0

# --- PostgreSQL (docker-compose publish cổng 5434 ra host) ---
EF_DATABASE_URL=postgresql://ecofashion:ecofashion@localhost:5434/ecofashion

# --- Redis (cache + throttle + BullMQ) ---
EF_REDIS_URL=redis://localhost:6381/0

# --- JWT ---
# Sinh secret mới: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
EF_JWT_SECRET=doi-secret-nay-truoc-khi-chay-that-0123456789
EF_ACCESS_TOKEN_TTL_SECONDS=900
EF_REFRESH_TOKEN_TTL_DAYS=14

# --- Admin khởi tạo (service seed dùng; đổi ngay sau lần đăng nhập đầu ở production) ---
EF_ADMIN_EMAIL=admin@ecofashion.vn
EF_ADMIN_PASSWORD=Admin123456!

# --- Cloudinary (ảnh sản phẩm, banner, avatar, ảnh đánh giá) ---
EF_CLOUDINARY_CLOUD_NAME=
EF_CLOUDINARY_API_KEY=
EF_CLOUDINARY_API_SECRET=
# Nguồn ảnh khi seed: auto (mặc định) = dùng link Cloudinary ĐÃ ĐÓNG GÓI trong scripts/seed/assets/.cloudinary-manifest.json — chạy được cả khi để trống
# khoá Cloudinary hoặc dùng tài khoản Cloudinary khác; upload = upload toàn bộ ảnh lên Cloudinary CỦA BẠN (cần 3 biến trên); static = URL tĩnh /static/seed.
# EF_SEED_IMAGE_SOURCE=auto

# --- Email (dev: mailpit trong compose; production: SMTP thật) ---
EF_MAIL_HOST=localhost
EF_MAIL_PORT=1026
EF_MAIL_SECURE=false
EF_MAIL_USER=
EF_MAIL_PASSWORD=
EF_MAIL_FROM=EcoFashion <no-reply@ecofashion.vn>

# --- PayOS (thu tiền QR/chuyển khoản tự động + chi trả shop) — https://my.payos.vn → Kênh thanh toán / Lệnh chi ---
# PLAN-0018: chỉ còn 2 phương thức cod + payos; mọi khoản tiền về SÀN rồi sàn tự đối soát + chi trả shop (cron 02:00).
# Trống (chủ dự án cung cấp sau) = phương thức `payos` tự TẮT (chỉ còn COD); chi trả shop lùi về "đánh dấu đã chuyển khoản tay", cron tự chi không chạy.
# Webhook khai báo trong dashboard PayOS: {EF_PUBLIC_URL}/api/v1/payments/payos/webhook (production phải https)
EF_PAYOS_CLIENT_ID=
EF_PAYOS_API_KEY=
EF_PAYOS_CHECKSUM_KEY=
EF_PAYOS_API_URL=https://api-merchant.payos.vn
# "Lệnh chi" (payout) dùng cặp khoá RIÊNG của tài khoản chi — nạp tiền vào tài khoản chi trước khi chạy kỳ đối soát
EF_PAYOS_PAYOUT_CLIENT_ID=
EF_PAYOS_PAYOUT_API_KEY=
EF_PAYOS_PAYOUT_CHECKSUM_KEY=

# --- OpenAI (module ai: gợi ý, chatbot, tóm tắt…) — trống thì mọi tính năng AI lùi về đường không-AI ---
EF_OPENAI_API_KEY=
EF_OPENAI_CHAT_MODEL=gpt-5.4-mini
EF_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EF_AI_DAILY_TOKEN_BUDGET=0
EF_OPENAI_VISION_MODEL=gpt-5.4-mini

# --- Replicate (AI thử đồ 2D — model IDM-VTON; token lấy ở https://replicate.com/account/api-tokens) ---
EF_REPLICATE_API_TOKEN=
EF_REPLICATE_TRYON_MODEL=cuuupid/idm-vton:c871bb9b046607b680449ecbae55fd8c6d945e0a1948644bf2361b3d021d3ff4

# --- Google OAuth (đăng nhập bằng Google trên web bán hàng — FE gửi id_token, BE xác minh audience = client id) ---
EF_GOOGLE_CLIENT_ID=

# --- Pexels (CHỈ khi seed: dự phòng cho script thay ảnh minh hoạ bằng ảnh thật theo ngành hàng — chưa có script) ---
# Lấy khoá miễn phí tại https://www.pexels.com/api/ — trống thì giữ ảnh minh hoạ tự sinh.
EF_PEXELS_API_KEY=

# --- Data retention (ngày) ---
EF_LOGIN_HISTORY_RETENTION_DAYS=180
EF_NOTIFICATION_PURGE_RETENTION_DAYS=90
EF_VIEW_EVENT_RETENTION_DAYS=90
EF_CHAT_SESSION_RETENTION_DAYS=90
